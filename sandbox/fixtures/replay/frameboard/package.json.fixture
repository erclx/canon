{
  "name": "frameboard",
  "version": "0.6.0",
  "description": "A local design board that coding agents draw on as plain HTML files",
  "keywords": [
    "design",
    "board",
    "canvas",
    "html",
    "coding-agent",
    "claude-code",
    "cli"
  ],
  "homepage": "https://github.com/erclx/frameboard#readme",
  "bugs": {
    "url": "https://github.com/erclx/frameboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erclx/frameboard.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "frameboard": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && rolldown -c rolldown.config.ts && bun scripts/copy-faces.ts",
    "dev": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && vite",
    "preview": "node dist/cli.js serve --root \"${CANON_PREVIEW_ROOT:-.}/test/fixtures/boards/basic\" --no-open --port ${PREVIEW_PORT:-4173}",
    "test": "vitest",
    "test:run": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --project node",
    "test:e2e": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && playwright test",
    "test:e2e:changed": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && playwright test --only-changed",
    "test:e2e:ui": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:full": "bun scripts/verify.ts && bun run test:e2e",
    "measure:canvas": "bun run build && playwright test -c e2e/perf/playwright.config.ts",
    "smoke:prod": "bun e2e/screenshot.ts --check-console-clean --require-base-url",
    "prepare": "husky",
    "design:sync": "bun scripts/design-sync.ts",
    "check": "bun scripts/verify.ts",
    "check:format": "oxfmt --check .",
    "format": "oxfmt .",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "screenshot": "PREVIEW_PORT=$(bash scripts/worktree-port.sh 4173) && export PREVIEW_PORT && bash scripts/screenshot.sh",
    "screenshot:compare": "bun run build && bun e2e/compare.ts",
    "readme-screenshot": "PREVIEW_PORT=$(bash scripts/worktree-port.sh 4173) && export PREVIEW_PORT && bash scripts/readme-screenshot.sh"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@base-ui/react": "^1.9.0",
    "@bramus/specificity": "^2.4.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5",
    "@vitest/ui": "^5",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "commander": "^15.0.0",
    "css-select": "^7.0.0",
    "d3-drag": "3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.10.2",
    "hono": "^4.13.13",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.57.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "parse5": "^8.0.1",
    "parse5-htmlparser2-tree-adapter": "^8.0.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "rolldown": "^1.2.14",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tinykeys": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vite": "^8.3.4",
    "vitest": "^5",
    "wouter": "^3.13.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
