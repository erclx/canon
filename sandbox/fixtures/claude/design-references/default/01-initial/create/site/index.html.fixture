<!doctype html>
<!-- A stand-in product site served locally, so a run captures without the
     network. Five sections a designer would name, each taller than a short
     band so the split keeps them apart, two nav entries that open a menu on
     hover, one primary action, and a strip pinned while the page scrolls. -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fieldnote</title>
    <style>
      :root { --ink: #1b1d22; --paper: #fbfaf7; --line: #e4e1da; --accent: #2f5d50; }
      * { box-sizing: border-box; }
      body { margin: 0; font: 17px/1.55 Georgia, 'Times New Roman', serif; color: var(--ink); background: var(--paper); }
      header { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; gap: 28px;
        padding: 16px 40px; background: var(--paper); border-bottom: 1px solid var(--line); }
      header strong { margin-right: auto; font-size: 20px; }
      nav { display: flex; gap: 24px; }
      .menu { position: relative; }
      .menu > span { cursor: default; }
      .menu ul { position: absolute; top: 28px; left: -16px; min-width: 200px; margin: 0; padding: 12px 16px;
        list-style: none; background: #fff; border: 1px solid var(--line); border-radius: 6px;
        opacity: 0; transform: translateY(-6px); pointer-events: none; transition: opacity 200ms, transform 200ms; }
      .menu:hover ul { opacity: 1; transform: none; pointer-events: auto; }
      .menu li { padding: 6px 0; }
      .cta { padding: 10px 18px; color: #fff; background: var(--accent); border: 0; border-radius: 4px; font: inherit; }
      .cta:hover { background: #244a40; }
      main section { min-height: 960px; padding: 120px 40px; border-bottom: 1px solid var(--line); }
      .hero { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
      .hero h1 { font-size: 64px; line-height: 1.05; margin: 0 0 24px; }
      .window { height: 420px; background: #fff; border: 1px solid var(--line); border-radius: 10px; }
      .strip { position: sticky; top: 72px; display: flex; gap: 48px; padding: 20px 40px; color: #77736b;
        background: var(--paper); border-bottom: 1px solid var(--line); }
      .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; }
      .cards article { min-height: 320px; padding: 28px; background: #fff; border: 1px solid var(--line); border-radius: 8px; }
      blockquote { max-width: 760px; margin: 0 auto; font-size: 32px; line-height: 1.3; }
      .plans { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 900px; margin: 48px auto 0; }
      .plans div { min-height: 380px; padding: 32px; background: #fff; border: 1px solid var(--line); border-radius: 8px; }
      footer { padding: 64px 40px; color: #77736b; }
      @media (max-width: 760px) {
        header { padding: 12px 16px; gap: 16px; }
        nav { display: none; }
        main section { padding: 72px 16px; }
        .hero, .cards, .plans { grid-template-columns: 1fr; }
        .hero h1 { font-size: 40px; }
      }
    </style>
  </head>
  <body>
    <header>
      <strong>Fieldnote</strong>
      <nav>
        <div class="menu">
          <span>Product</span>
          <ul><li>Notebooks</li><li>Field sync</li><li>Sharing</li></ul>
        </div>
        <div class="menu">
          <span>Resources</span>
          <ul><li>Guides</li><li>Changelog</li><li>Community</li></ul>
        </div>
        <span>Pricing</span>
      </nav>
      <button class="cta">Start a notebook</button>
    </header>
    <div class="strip"><span>Used by survey teams</span><span>Herbaria</span><span>Coastal labs</span></div>
    <main>
      <section class="hero">
        <div>
          <h1>Notes that survive the field.</h1>
          <p>Write offline on any device, then sync the whole notebook when you reach a signal.</p>
          <button class="cta">Start a notebook</button>
        </div>
        <div class="window" aria-label="Product window"></div>
      </section>
      <section>
        <h2>Built for the walk back to camp</h2>
        <div class="cards">
          <article><h3>Offline first</h3><p>Every page saves to the device before it tries the network.</p></article>
          <article><h3>Photo pins</h3><p>Pin a photo to the line that describes it, not to the page.</p></article>
          <article><h3>Plain export</h3><p>Export a notebook as text and images, readable without the app.</p></article>
        </div>
      </section>
      <section>
        <blockquote>We stopped losing a day of notes every time a tablet died on the ridge.</blockquote>
      </section>
      <section>
        <h2>Two plans</h2>
        <div class="plans">
          <div><h3>Solo</h3><p>One person, every notebook, synced across their devices.</p></div>
          <div><h3>Team</h3><p>Shared notebooks with review, for a crew working one site.</p></div>
        </div>
      </section>
      <section>
        <h2>Questions people ask before a season</h2>
        <p>How much storage does a season take? What happens when two people edit one page offline?</p>
      </section>
    </main>
    <footer>Fieldnote. A fixture site for the design-references scenario.</footer>
  </body>
</html>
