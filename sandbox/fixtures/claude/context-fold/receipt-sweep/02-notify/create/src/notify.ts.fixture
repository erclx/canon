export interface Notification {
  readonly to: string
  readonly body: string
  readonly retries: number
}

export function send(notification: Notification): void {
  for (let attempt = 0; attempt <= notification.retries; attempt += 1) {
    if (deliver(notification)) return
  }
}

function deliver(notification: Notification): boolean {
  process.stdout.write(`${notification.to}: ${notification.body}\n`)
  return true
}
