.btn {
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-default);
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.3;
}

.btn-primary {
  background: var(--color-accent);
  color: white;
  border: none;
}

.btn-secondary {
  background: transparent;
  color: var(--color-accent);
  border: 1px solid var(--color-accent);
}
