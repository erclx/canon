.btn {
  padding: 12px 18px;
  border-radius: 6px;
  font-size: 14px;
}

.btn-primary {
  background: var(--color-accent);
  color: white;
  border: none;
}

.btn-secondary {
  background: transparent;
  color: var(--color-accent);
  border: 1px solid var(--color-accent);
}

.btn-ghost {
  background: transparent;
  color: var(--color-fg-muted);
  border: none;
}
