import "./Button.css";

type Variant = "primary" | "secondary" | "ghost";

export function Button({
  variant = "primary",
  children,
  onClick,
}: {
  variant?: Variant;
  children: React.ReactNode;
  onClick?: () => void;
}) {
  return (
    <button className={`btn btn-${variant}`} onClick={onClick}>
      {children}
    </button>
  );
}
