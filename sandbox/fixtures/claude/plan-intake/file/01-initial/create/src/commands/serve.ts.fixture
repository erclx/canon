export function runServe(args: string[]) {
  let port = 3000
  let host = 'localhost'

  for (let i = 0; i < args.length; i += 1) {
    if (args[i] === '--port') {
      port = Number(args[i + 1] ?? 3000)
      i += 1
    }
    if (args[i] === '--host') {
      host = args[i + 1] ?? 'localhost'
      i += 1
    }
  }

  if (Number.isNaN(port)) {
    throw new Error('serve failed: --port needs a number')
  }

  console.log(`listening on http://${host}:${port}`)
}
