<!doctype html>
<!--
  Generated by scripts/core/regen-hero.sh from assets/captures/install.html.tmpl. Do not
  edit this file. The token block below is filled from
  `canon design css --no-components`, so a value moved in src/design/tokens.ts
  moves this frame and `bun run check` fails on the difference.

  Source for install.png. Every line of terminal text below came from a real run
  of the three commands against a scratch CLAUDE_CONFIG_DIR. Re-run them before
  changing the text, never hand-edit the output. The text lives in the template
  beside this comment.

  Two elisions, both deliberate. Progress lines are dropped for length, and the
  version row of `claude plugin list` is dropped because a version rendered into
  a committed binary is wrong from the next release onward and nothing checks it.
  The enabled row proves the install landed without dating the frame.
-->
<html>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="{{FAVICON}}" />
    <style>
{{TOKENS}}

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background: transparent;
        padding: 28px;
        font-family: 'Noto Sans Mono', 'DejaVu Sans Mono', monospace;
      }
      .window {
        width: 760px;
        background: var(--color-background);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 18px 48px var(--frame-shadow, rgba(0, 0, 0, 0.45));
      }
      .titlebar {
        height: 34px;
        background: var(--color-chrome);
        display: flex;
        align-items: center;
        padding: 0 14px;
        gap: 8px;
      }
      .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
      }

      /* The three dots imitate somebody else's window chrome rather than
         speaking this system's palette, so they stay literal. Promoting them to
         roles would put three colors in the record that no surface of ours ever
         chose. The green matches the success role by coincidence of the chrome
         being imitated, not by derivation from it. Named here rather than left
         as bare hex so the two shared with the other three templates read as
         one value repeated, not four independent guesses. */
      :root {
        --chrome-dot-red: #ec6a5e;
        --chrome-dot-yellow: #f4bf50;
        --key-color: #d2a8ff;
      }
      .red {
        background: var(--chrome-dot-red);
      }
      .yellow {
        background: var(--chrome-dot-yellow);
      }
      .green {
        background: #61c454;
      }
      .title {
        flex: 1;
        text-align: center;
        color: var(--color-muted);
        font-size: 12px;
        letter-spacing: 0.02em;
        margin-right: 46px;
      }
      pre {
        padding: 20px 22px 24px;
        font-size: 14px;
        line-height: 1.62;
        color: var(--color-text-body);
        white-space: pre-wrap;
      }
      .prompt {
        color: var(--color-accent);
      }
      .cmd {
        color: var(--color-text);
        font-weight: 600;
      }
      .muted {
        color: var(--color-muted);
      }
      .ok {
        color: var(--color-success);
      }

      /* One surface asks for this and the record holds no role for it. A role
         invented for a single reader is a value nothing derives from, so it
         stays literal until a second surface needs it. Named above with the
         dots for the same reason: one place to read the value, not a hex
         buried in a selector. */
      .key {
        color: var(--key-color);
      }
      .blank {
        display: block;
        height: 0.62em;
      }
    </style>
  </head>
  <body>
    <div class="window">
      <div class="titlebar">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="title">canon install</span>
      </div>
      <pre><span class="prompt">$</span> <span class="cmd">claude plugin marketplace add https://github.com/erclx/canon</span>
<span class="muted">Cloning repository (timeout: 120s): https://github.com/erclx/canon.git</span>
<span class="muted">Clone complete, validating marketplace…</span>
<span class="ok">✔</span> Successfully added marketplace: canon (declared in user settings)
<span class="blank"></span>
<span class="prompt">$</span> <span class="cmd">claude plugin install canon@canon</span>
<span class="ok">✔</span> Successfully installed plugin: canon@canon (scope: user)
<span class="blank"></span>
<span class="prompt">$</span> <span class="cmd">claude plugin list</span>
Installed plugins:
<span class="blank"></span>
  <span class="key">❯</span> canon@canon
    Scope: user
    Status: <span class="ok">✔</span> enabled</pre>
    </div>
  </body>
</html>
