<!doctype html>
<!--
  Generated by scripts/core/regen-hero.sh from assets/captures/catalog.html.tmpl. Do not
  edit this file. Each count is read from a CLI catalog at build time and the
  Hero stage fails when the frame falls behind the tree. The sample names are
  chosen by hand and the generator fails on a name that has left its catalog.

  A ledger rather than a grid of cards: five rows carrying a count, a domain
  and a few real names, with no boxes and no window chrome. The palette
  arrives from `canon design css --no-components` like every other frame.
-->
<html>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="{{FAVICON}}" />
    <style>
{{TOKENS}}

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background: transparent;
        padding: 24px;
      }
      .window {
        width: 900px;
        background: var(--color-background);
        border-radius: 12px;
        padding: 28px 44px 20px;
        font-family: 'Noto Sans Mono', 'DejaVu Sans Mono', monospace;
        color: var(--color-text-body);
      }
      .row {
        display: grid;
        grid-template-columns: 96px 150px 1fr;
        align-items: baseline;
        padding: 20px 0;
        border-bottom: 1px solid var(--color-border);
      }
      .row:last-child {
        border-bottom: 0;
      }
      .count {
        font-size: 34px;
        font-weight: 700;
        color: var(--color-text);
        text-align: right;
        padding-right: 28px;
        font-variant-numeric: tabular-nums;
      }
      .domain {
        font-size: 17px;
        font-weight: 600;
        color: var(--color-accent);
      }
      .names {
        font-family: 'Noto Sans Mono', 'DejaVu Sans Mono', monospace;
        font-size: 14px;
        color: var(--color-text-secondary);
        white-space: nowrap;
      }
    </style>
  </head>
  <body>
    <div class="window">
{{LEDGER_ROWS}}
    </div>
  </body>
</html>
