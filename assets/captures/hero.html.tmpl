          </div>
          <div class="cmd"><span class="sigil">$</span>claude plugin install canon@canon</div>
          <div class="needs">Needs Claude Code. The CLI needs Bun on your path.</div>
        </div>

        <div class="cols">
          <div class="col">
            <div class="col-head">
              <span class="col-name">skills</span><span class="col-count">{{SKILL_COUNT}}</span>
