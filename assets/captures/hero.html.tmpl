          </div>

          <div class="col">
            <div class="col-head">
              <span class="col-name">rules</span><span class="col-count">{{RULE_COUNT}}</span>
            </div>
            <div class="col-dest">.claude/rules/</div>
{{RULE_ENTRIES}}
            <div class="more">+{{RULE_MORE}} more</div>
          </div>

          <div class="col">
            <div class="col-head">
              <span class="col-name">standards</span><span class="col-count">{{STANDARD_COUNT}}</span>
            </div>
            <div class="col-dest">via canon standards</div>
{{STANDARD_ENTRIES}}
            <div class="more">+{{STANDARD_MORE}} more</div>
          </div>
        </div>
      </div>

      <div class="stats">
        <span><b>{{COMMAND_COUNT}}</b>CLI commands</span>
        <span><b>{{GOV_STACK_COUNT}}</b>governance stacks</span>
        <span><b>{{TOOLING_STACK_COUNT}}</b>tooling stacks</span>
        <span class="note">counts read from the catalogs at build time</span>
      </div>
    </div>
  </body>
</html>
