{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "gitignoreRoot": ["."],
  "dictionaryDefinitions": [
    {
      "name": "project-terms",
      "path": "./.cspell/project-terms.txt",
      "addWords": true
    },
    {
      "name": "tech-stack",
      "path": "./.cspell/tech-stack.txt",
      "addWords": true
    },
    {
      "name": "banned-spellings",
      "path": "./.cspell/banned-spellings.txt",
      "addWords": false
    }
  ],
  "dictionaries": ["project-terms", "tech-stack"],
  "ignoreRegExpList": [
    "/'[0-9A-Fa-f]{6}'/g",
    "/data:image\\/svg\\+xml,[^\"]*/g"
  ],
  "ignorePaths": [
    ".cspell/**",
    "tooling/**",
    ".git/**",
    "src/design/fonts.ts",
    "src/teach/fonts.ts"
  ],
  "overrides": [
    {
      "filename": ["**/*.html.tmpl"],
      "languageId": "html"
    },
    {
      "filename": [
        "src/markdown/bans.ts",
        "src/markdown/bans.test.ts",
        "src/markdown/gate.test.ts",
        "src/markdown/scan.test.ts",
        "src/markdown/scan.ts",
        "canon/context/cli/audits.md",
        "canon/context/development/verification.md",
        "docs/agents/markdown-audit.md"
      ],
      "dictionaries": ["banned-spellings"]
    }
  ]
}
