#!/usr/bin/env sh

# Runs the post-merge steps through `canon hooks post-merge`: archive the task a
# merged pull request closed, push the records, reclaim merged worktrees,
# reinstall the CLI, and update the plugin cache. The verb owns the order and
# each line it prints. `canon/context/development/hooks/husky.md` carries why.
#
# CANON_SKIP_RECLAIM=1 turns off the worktree reclaim.
# CANON_SKIP_UPGRADE=1 turns off the CLI reinstall.
# CANON_SKIP_PLUGIN_UPDATE=1 turns off the plugin cache update.
#
# The reclaim reads merge state through `gh`, so a machine without it on PATH
# reclaims nothing and says nothing. Install `gh` to turn it on.
#
# Husky runs this as `sh -e`, and `post-rewrite` sources it on a rebase, so
# every test sits inside an `if` or an `||` and nothing here exits non-zero.

root=$(git worktree list --porcelain 2>/dev/null | grep -m 1 '^worktree ' | cut -d' ' -f2-) || root=''
[ -n "$root" ] || exit 0

# The board is shared scratch at the main worktree root, and a checkout with
# no board runs none of the steps.
[ -d "$root/.canon/tasks" ] || exit 0

if ! command -v canon >/dev/null 2>&1; then
  exit 0
fi

# A global binary older than the verb cannot run it, and the verb carries the
# only step that would update it, so reinstall here and probe again. The next
# merge's ORIG_HEAD range never covers this one, so the verb runs now whenever
# the reinstalled binary carries it.
#
# The probe reads the verb's own usage line rather than the exit, since an
# older binary answers an unknown command's `--help` with its root help and
# exits zero. Its arguments are the command to probe, never the hook's own.
has_verb() {
  "$@" hooks post-merge --help 2>/dev/null | grep -q '^Usage: canon hooks post-merge'
}

if ! has_verb canon; then
  if [ -z "$CANON_SKIP_UPGRADE" ]; then
    CANON_NON_INTERACTIVE=1 canon upgrade >/dev/null 2>&1 || true
  fi
fi

# A registry that has not published the verb yet leaves the reinstalled binary
# without it, so a checkout carrying the source runs the verb from there. The
# probe runs against that source too, since a pull inside a linked worktree
# can leave the main checkout without the verb.
source_cli="$root/src/cli.ts"
if has_verb canon; then
  canon hooks post-merge --root "$root" || true
elif [ -f "$source_cli" ] && command -v bun >/dev/null 2>&1 && has_verb bun "$source_cli"; then
  bun "$source_cli" hooks post-merge --root "$root" || true
fi
