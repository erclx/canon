#!/usr/bin/env sh

# Runs the post-merge steps through `canon hooks post-merge`: archive the task a
# merged pull request closed, push the records, retire the fan-in members a
# merged integrator named, reclaim merged worktrees, reinstall the CLI, and
# update the plugin cache. The verb owns the order and each line it prints.
# `canon/context/development/local-loop.md` carries why.
#
# CANON_SKIP_RECLAIM=1 turns off the member retirement and the worktree
# reclaim, since both remove worktrees.
# CANON_SKIP_UPGRADE=1 turns off the CLI reinstall.
# CANON_SKIP_PLUGIN_UPDATE=1 turns off the plugin cache update.
#
# Both read merge state through `gh`, so a machine without it on PATH retires
# and reclaims nothing and says nothing. Install `gh` to turn them on.
#
# Husky runs this as `sh -e`, and `post-rewrite` sources it on a rebase, so
# every test sits inside an `if` or an `||` and nothing here exits non-zero.

root=$(git worktree list --porcelain 2>/dev/null | grep -m 1 '^worktree ' | cut -d' ' -f2-) || root=''
[ -n "$root" ] || exit 0

# The board is shared scratch at the main worktree root, and a checkout with
# no board runs none of the steps.
[ -d "$root/.canon/tasks" ] || exit 0

if ! command -v canon >/dev/null 2>&1; then
  exit 0
fi

# A global binary older than the verb cannot run it, and its owner upgrades it
# by hand. The probe reads the verb's own usage line rather than the exit,
# since an older binary answers an unknown command's `--help` with its root
# help and exits zero. Its arguments are the command to probe, never the
# hook's own.
has_verb() {
  "$@" hooks post-merge --help 2>/dev/null | grep -q '^Usage: canon hooks post-merge'
}

# A global binary without the verb falls back to a checkout carrying the
# source. The probe runs against that source too, since a pull inside a linked
# worktree can leave the main checkout without the verb.
source_cli="$root/src/cli.ts"
if has_verb canon; then
  canon hooks post-merge --root "$root" || true
elif [ -f "$source_cli" ] && command -v bun >/dev/null 2>&1 && has_verb bun "$source_cli"; then
  bun "$source_cli" hooks post-merge --root "$root" || true
else
  echo 'canon is too old to run the post-merge hook. Run `canon upgrade`.' >&2
fi
