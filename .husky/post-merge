#!/usr/bin/env sh

# Archives the task a pull merged, so the board closes without a person naming it.
#
# Every step before the merge fires from a chain and the archive used to fire
# when a person remembered, so shipped tasks accumulated on a board that reads
# as ready to hand a worker. This is the only event that lands after a merge.
#
# The pull request number is the link. `git-pr` writes `Pull request: #NNN` onto
# the task when it opens one, and every merge on `main` is a squash carrying
# that number in its subject, so the number survives a merge where a branch name
# does not. Matching on it is what separates a shipped task from an abandoned
# one, which a blind sweep of every all-`[x]` task cannot do.
#
# The hook extracts the number and nothing else. `canon tasks archive` owns every
# gate, because the skill calls the same command and two callers gating in two
# places drift into archiving differently. Each gate refuses with a non-zero
# exit rather than reporting, since nobody is watching this run.
#
# Husky runs this as `sh -e`, so the shebang is advisory and any bare command
# returning non-zero aborts the hook and prints a husky failure. Keep every
# test inside an `if` condition, which errexit exempts.
#
# The hook also removes the worktree and branch behind a pull request the merge
# retired, so a shipped directory goes without a person remembering.
# CANON_SKIP_RECLAIM=1 turns that step off.
#
# That step reads merge state through `gh`, so a machine without it on PATH
# reclaims nothing and says nothing. Install `gh` to turn it on. Every other
# reason it can refuse for reports itself on the merge that hit it.
#
# The hook also reinstalls the global `canon` binary once it drifts behind
# what is published, so PATH runs the same contract this repository ships.
# CANON_SKIP_UPGRADE=1 turns that step off.
#
# The hook also updates the marketplace plugin cache once it drifts behind
# what the binary above just reinstalled, so the skill catalog, the standards
# corpus, and the snippets move together rather than waiting on an operator
# to run `claude plugin update` by hand.
# CANON_SKIP_PLUGIN_UPDATE=1 turns that step off.

root=$(git worktree list --porcelain 2>/dev/null | grep -m 1 '^worktree ' | cut -d' ' -f2-) || root=''
[ -n "$root" ] || exit 0

# The board is shared scratch at the main worktree root, and `git worktree
# list` puts that root first. A pull inside a linked worktree fires this same
# hook, so trusting the working directory would read a board that is not there.
board="$root/.canon/tasks"
[ -d "$board" ] || exit 0

if ! command -v canon >/dev/null 2>&1; then
  exit 0
fi

# Every subject the pull brought in, not just the tip. One pull routinely
# fast-forwards over several merges, and reading HEAD alone would archive the
# last one's task and silently strand the rest. `git pull` sets ORIG_HEAD to the
# pre-merge tip, so the range is exactly what arrived. A merge that leaves no
# ORIG_HEAD falls back to the tip.
if git rev-parse --verify --quiet ORIG_HEAD >/dev/null 2>&1; then
  subjects=$(git log ORIG_HEAD..HEAD --pretty=%s 2>/dev/null) || subjects=''
else
  subjects=$(git log -1 --pretty=%s 2>/dev/null) || subjects=''
fi

# A squash carries `(#NNN)` at the end of the subject. A release or a merge
# naming no pull request yields nothing here, which is what keeps this quiet on
# the runs it has nothing to say about.
numbers=$(printf '%s\n' "$subjects" | sed -n 's/.*(#\([0-9][0-9]*\))[[:space:]]*$/\1/p')

if [ -n "$numbers" ]; then
  printf '%s\n' "$numbers" | while IFS= read -r number; do
    [ -n "$number" ] || continue

    # `--json` keeps the record on stdout parseable and every refusal reason
    # with it. A refusal is ordinary here, since most merges close no task.
    if record=$(canon tasks archive --pull-request "$number" --root "$root" --json 2>/dev/null); then
      task=$(printf '%s' "$record" | sed -n 's/.*"task":"\([^"]*\)".*/\1/p')
      printf '\n📦 Archived %s, closed by #%s.\n\n' "$task" "$number"
      continue
    fi

    reason=$(printf '%s' "$record" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')

    # No task names this pull request, which is what a release or an unlinked
    # branch looks like. Nothing to report.
    if [ "$reason" = "no-match" ] || [ "$reason" = "no-board" ] || [ -z "$reason" ]; then
      continue
    fi

    message=$(printf '%s' "$record" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
    printf '\n📋 Task not archived for #%s: %s\n' "$number" "${message:-$reason}"
    printf 'Run /task-board to resolve it by hand.\n\n'
  done
fi

# The eight gitignored record folders live on one disk and nowhere else, and a
# merge is the event that changes them most. This runs on every merge rather
# than only on one that archived a task, since a review report and a memory
# entry both land on runs that close nothing.
#
# It sits last so a slow or unreachable remote delays no archiving, and inside
# an `if` so a push failing offline still leaves this hook exiting zero.
if backup=$(canon records push --root "$root" --json 2>/dev/null); then
  changed=$(printf '%s' "$backup" | sed -n 's/.*"changed":\([0-9][0-9]*\).*/\1/p')
  if [ -n "$changed" ] && [ "$changed" != "0" ]; then
    printf '\n🗄️  Backed up %s record path(s).\n\n' "$changed"
  fi
else
  reason=$(printf '%s' "$backup" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')

  # No records history on this machine, which is every checkout that never ran
  # the one-time setup. Nothing to report.
  if [ "$reason" != "no-repository" ]; then
    printf '\n🗄️  Records not backed up: %s\n' "${reason:-unknown}"
    if [ "$reason" = "unsafe-payload" ]; then
      printf 'Run canon records push to see the blocked paths.\n\n'
    else
      printf 'Run canon records push when the remote is reachable.\n\n'
    fi
  fi
fi

# Removes the worktree and the branch behind a merged pull request, so a shipped
# branch's directory goes without a person remembering. Reporting is what the
# tree already did through `canon worktrees list`, and it is what produced the
# wall of stale worktrees this step was filed against.
#
# The verb removes only what clears all three of its conditions: a merged pull
# request, a clean working tree, and no live session holding the directory. A
# worktree a live session still holds is refused rather than removed, so an
# idle worker keeps its own directory until someone retires the session.
#
# CANON_SKIP_RECLAIM=1 skips this block, which is the one route to stop it
# short of editing the hook, which then drifts from the committed copy.
#
# The call carries no `--root` and no `cd`, unlike the two steps above it, and
# that is load-bearing rather than an oversight. Git runs a hook from the top
# level of the worktree the pull happened in, and the verb reads its own
# working directory to refuse the worktree it is standing in. Passing a root
# turns the running worktree into an ordinary candidate and lets a pull inside
# a linked worktree delete the ground under itself. The steps above pass
# `--root "$root"` for the opposite reason, because the board and the records
# live at the main root and the working directory would read the wrong tree.
#
# Sits before the upgrade block rather than after it, since that block
# reinstalls the binary this hook is running under and every step after it
# would run against a package that moved. `post-rewrite` delegates here on its
# `rebase` argument, so a machine set to `pull.rebase=true` gets the removals
# from that path instead.
if [ -z "$CANON_SKIP_RECLAIM" ]; then
  # The exit decides nothing here and the fields decide everything. A run that
  # removes one worktree and fails on another exits 1 while having already
  # deleted a directory, so a report keyed on the exit prints the failure and
  # never names the removal, which is the one act in this file nothing undoes.
  # The verb writes the record before exiting 1 as readily as before exiting 0,
  # so reading the fields on both paths costs nothing and loses nothing.
  reclaim=$(canon worktrees reclaim --json 2>/dev/null) || true

  removed=$(printf '%s' "$reclaim" | sed -n 's/.*"removed":\([0-9][0-9]*\).*/\1/p')
  failed=$(printf '%s' "$reclaim" | sed -n 's/.*"failed":\([0-9][0-9]*\).*/\1/p')
  reason=$(printf '%s' "$reclaim" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')

  if [ -n "$removed" ] && [ "$removed" != "0" ]; then
    printf '\n🧹 Reclaimed %s worktree(s) whose pull request merged.\n\n' "$removed"
  fi

  # An unreadable reading refuses every verdict rather than some of them, so
  # the removals silently never happen and one line is what says so. No record
  # at all is an older global binary carrying no `--json` flag, which stays
  # quiet the way every such gap here does until a release lands.
  #
  # `gh-missing` is the one reason that stays quiet with it. A machine without
  # `gh` answers that on every merge forever, which is the shape the records
  # push above treats `no-repository` as, and a line nobody can act on twice
  # teaches a reader to skip the whole block. The header carries the gap
  # instead, where a person looking for why nothing reclaims will read it.
  if [ -n "$reason" ] && [ "$reason" != "gh-missing" ]; then
    printf '\n🧹 Worktrees not reclaimed: %s\n' "$reason"
    printf 'Run canon worktrees list to read the state by hand.\n\n'
  elif [ -n "$failed" ] && [ "$failed" != "0" ]; then
    printf '\n🧹 %s worktree(s) could not be removed.\n' "$failed"
    printf 'Run canon worktrees reclaim to read which step failed.\n\n'
  fi
fi

# Reinstalls the global binary once it drifts behind what is published, so
# every hook, script, and check driven through PATH runs the same contract
# this repository ships rather than an older one nobody noticed. Nothing here
# is a source checkout's problem, since `canon upgrade` refuses one on its own
# and reports that refusal same as any other.
#
# CANON_SKIP_UPGRADE=1 skips this block, which is the one route to stop it
# short of editing the hook, which then drifts from the committed copy.
#
# Sits last, after the records push, for the same reason that block does: a
# slow or unreachable registry delays neither archiving nor backup. Wrapped in
# an `if` so a failed reinstall still leaves the hook exiting zero, and the
# `canon` presence check ran already, at the top of this file.
if [ -z "$CANON_SKIP_UPGRADE" ]; then
  if upgrade=$(CANON_NON_INTERACTIVE=1 canon upgrade --json 2>/dev/null); then
    state=$(printf '%s' "$upgrade" | sed -n 's/.*"state":"\([^"]*\)".*/\1/p')

    # Current is the ordinary outcome on most merges. The archive block above
    # stays quiet on no-match and no-board, and the records push prints only
    # when something changed, so this stays quiet on the same shape of
    # no-op rather than putting a line on every merge that says nothing moved.
    if [ "$state" != "current" ]; then
      message=$(printf '%s' "$upgrade" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
      if [ -n "$message" ]; then
        printf '\n⬆️  %s\n\n' "$message"
      fi
    fi
  else
    # A record on stdout is a refusal reported the same way an install
    # failure is: with the versions it was moving between, on this same
    # `message` field. No record at all is an older global binary carrying no
    # `upgrade` subcommand, which stays quiet the way every such gap here
    # does until a release lands.
    message=$(printf '%s' "$upgrade" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
    if [ -n "$message" ]; then
      printf '\n⬆️  Not upgraded: %s\n\n' "$message"
    fi
  fi
fi

# Updates the marketplace plugin cache once it drifts behind the binary the
# block above just reinstalled, so a dispatched session stops resolving a
# retired skill body while waiting on an operator to run `claude plugin
# update` by hand.
#
# CANON_SKIP_PLUGIN_UPDATE=1 skips this block, which is the one route to stop
# it short of editing the hook, which then drifts from the committed copy.
#
# Sits last, after the binary reinstall, for the same reason that block sits
# after the records push: a slow or unreachable marketplace delays neither.
# Wrapped in an `if` so a failed update still leaves the hook exiting zero,
# and the `canon` presence check ran already, at the top of this file.
if [ -z "$CANON_SKIP_PLUGIN_UPDATE" ]; then
  if plugin_update=$(canon claude plugin-update --json 2>/dev/null); then
    state=$(printf '%s' "$plugin_update" | sed -n 's/.*"state":"\([^"]*\)".*/\1/p')

    # Current is the ordinary outcome on most merges, matching the silence
    # the binary reinstall keeps on its own no-op state.
    if [ "$state" != "current" ]; then
      message=$(printf '%s' "$plugin_update" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
      if [ -n "$message" ]; then
        printf '\n🔌 %s\n\n' "$message"
      fi
    fi
  else
    # A record on stdout is a refusal reported the same way an update
    # failure is: with the id and version it was moving from, on this same
    # `message` field. No record at all is an older global binary carrying
    # no `plugin-update` subcommand, which stays quiet the way every such
    # gap here does until a release lands.
    reason=$(printf '%s' "$plugin_update" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')

    # `no-claude` and `no-plugin` are permanent conditions on a project that
    # never carries the marketplace plugin at all, matching `gh-missing` and
    # `no-repository` above: a machine that will never fix either stays quiet
    # on every merge rather than printing a line nobody can act on twice.
    if [ "$reason" != "no-claude" ] && [ "$reason" != "no-plugin" ]; then
      message=$(printf '%s' "$plugin_update" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
      if [ -n "$message" ]; then
        printf '\n🔌 Plugin not updated: %s\n\n' "$message"
      fi
    fi
  fi
fi
