---
import '../../src/styles/global.css'
import Ask from '../../src/components/beats/ask.astro'
import Dispatch from '../../src/components/beats/dispatch.astro'
import Evidence from '../../src/components/beats/evidence.astro'
import Gate from '../../src/components/beats/gate.astro'
import Loop from '../../src/components/beats/loop.astro'
import Memory from '../../src/components/beats/memory.astro'
import Merge from '../../src/components/beats/merge.astro'
import Plan from '../../src/components/beats/plan.astro'
import Rules from '../../src/components/beats/rules.astro'
import Skills from '../../src/components/beats/skills.astro'
import Workers from '../../src/components/beats/workers.astro'
import Panel from '../../src/components/panel.astro'
import Close from '../../src/components/sections/close.astro'
import Field from '../../src/components/sections/field.astro'
import Fold from '../../src/components/sections/fold.astro'
import InstallSteps from '../../src/components/sections/install-steps.astro'
import Proof from '../../src/components/sections/proof.astro'
import Provenance from '../../src/components/sections/provenance.astro'
import SiteFooter from '../../src/components/site-footer.astro'
import SiteNav from '../../src/components/site-nav.astro'

const beats = [
  { id: 'ask', Component: Ask },
  { id: 'rules', Component: Rules },
  { id: 'skills', Component: Skills },
  { id: 'plan', Component: Plan },
  { id: 'dispatch', Component: Dispatch },
  { id: 'workers', Component: Workers },
  { id: 'gate', Component: Gate },
  { id: 'memory', Component: Memory },
  { id: 'evidence', Component: Evidence },
  { id: 'loop', Component: Loop },
  { id: 'merge', Component: Merge },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="canon-gallery-marker" content="1" />
    <title>Component gallery</title>
  </head>
  <body>
    <main>
      <section id="site-nav">
        <h2>site-nav</h2>
        <SiteNav />
      </section>
      <section id="fold">
        <h2>fold</h2>
        <Fold />
      </section>
      <section id="proof">
        <h2>proof</h2>
        <Proof />
      </section>
      {
        beats.map(({ id, Component }) => (
          <section id={`beat-${id}`}>
            <h2>{id}</h2>
            <div class="grp">
              <div class="bin">
                <Component />
              </div>
            </div>
          </section>
        ))
      }
      <section id="provenance">
        <h2>provenance</h2>
        <Provenance />
      </section>
      <section id="install-steps">
        <h2>install-steps</h2>
        <InstallSteps />
      </section>
      <section id="field">
        <h2>field</h2>
        <Field />
      </section>
      <section id="close">
        <h2>close</h2>
        <Close />
      </section>
      <section id="site-footer">
        <h2>site-footer</h2>
        <SiteFooter />
      </section>
      <section id="panel">
        <h2>panel</h2>
        <Panel />
      </section>
      <section id="group">
        <h2>group</h2>
        <p class="unrendered">Unrendered. Needs family (string, required).</p>
      </section>
      <section id="turn">
        <h2>turn</h2>
        <p class="unrendered">
          Unrendered. Needs id, who, as, say, note (string, required).
        </p>
      </section>
      <section id="band">
        <h2>band</h2>
        <p class="unrendered">
          Unrendered. Needs id, head, cap (string, required).
        </p>
      </section>
      <section id="panel-group">
        <h2>panel-group</h2>
        <p class="unrendered">Unrendered. Needs label (string, required).</p>
      </section>
      <section id="panel-row">
        <h2>panel-row</h2>
        <p class="unrendered">
          Unrendered. Needs name, value (string, required).
        </p>
      </section>
    </main>
    <style>
      main {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        padding: 2rem;
      }
      section {
        border-top: 1px solid var(--color-border);
        padding-top: 1.25rem;
      }
      section > h2 {
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: var(--type-label-size);
        color: var(--color-muted);
        margin: 0 0 0.75rem;
      }
      .unrendered {
        color: var(--color-muted);
        font-style: italic;
      }
    </style>
  </body>
</html>
