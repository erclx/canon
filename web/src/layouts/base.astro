---
import '../styles/global.css'
import { FONT_FACES } from '../../../src/design/fonts'
import SiteFooter from '../components/site-footer.astro'
import SiteNav from '../components/site-nav.astro'
import { site, skipLink } from '../content/copy'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props

/**
 * The card is captured from the route under `web/card-src/`, which
 * `web/card.config.mjs` serves and the published build never reads. Its stamp
 * digests the route's address rather than its markup, so an edit to that route,
 * to `site` above, or to the mark leaves the PNG stale until someone
 * re-captures it. A card needs an absolute URL, so it is resolved against the
 * deployed origin rather than written as a path. It is not named for the
 * route, since `check-card-exclusion.sh` fails a build carrying any file
 * named `og-card`.
 */
const cardImage = new URL('/assets/social-card.png', site.origin).href
const card = { width: 1200, height: 630 }
const cardAlt = `${site.name}: ${site.tagline}`

/**
 * `tokens.css` names Geist for every role, and nothing served the face, so the
 * page rendered in the visitor's system sans. The vendored subset is inlined
 * once here with `font-display: block`, which is what the reference was judged
 * in, rather than fetched as a second request that paints the fallback first.
 */
const geist = FONT_FACES.find((face) => face.family === 'Geist Variable')
if (!geist)
  throw new Error('src/design/fonts.ts carries no Geist Variable face')
const fontFace = `@font-face{font-family:'${geist.family}';font-weight:${geist.weight};font-display:block;src:url(data:font/woff2;base64,${geist.base64}) format('woff2');}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={site.origin} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site.origin} />
    <meta property="og:image" content={cardImage} />
    <meta property="og:image:width" content={String(card.width)} />
    <meta property="og:image:height" content={String(card.height)} />
    <meta property="og:image:alt" content={cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardImage} />

    <style is:inline set:html={fontFace}></style>

    <script is:inline>
      /**
       * Runs before first paint, so a stored or preferred theme never flashes
       * the other ground, and so a still asked for with ?still lands every
       * figure at its end state before the first frame rather than after it.
       */
      const stored = (() => {
        try {
          return localStorage.getItem('canon-theme')
        } catch {
          return null
        }
      })()
      const preferred = window.matchMedia('(prefers-color-scheme: light)')
        .matches
        ? 'light'
        : 'dark'
      const theme = stored === 'light' || stored === 'dark' ? stored : preferred
      document.documentElement.setAttribute('data-theme', theme)
      if (new URLSearchParams(location.search).has('still')) {
        document.documentElement.classList.add('still')
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#ask">{skipLink}</a>
    <SiteNav />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <script>
      /**
       * The figure build. Each `[data-build]` element lands once as it enters
       * the viewport, staggered by its place among its siblings, and is then
       * unobserved, since a reveal that replays on every pass is looping motion.
       * The class is added whatever the motion preference: the stylesheet
       * decides whether it animates, so a reader who prefers no motion still
       * reaches the end state rather than an empty figure.
       */
      const pieces = [...document.querySelectorAll<HTMLElement>('[data-build]')]
      for (const piece of pieces) {
        const siblings = piece.parentElement?.children
        const index = siblings ? [...siblings].indexOf(piece) : 0
        piece.style.setProperty('--build-index', String(index))
      }

      const builder = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            entry.target.classList.add('is-built')
            builder.unobserve(entry.target)
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -6% 0px' },
      )
      for (const piece of pieces) builder.observe(piece)
    </script>
  </body>
</html>
