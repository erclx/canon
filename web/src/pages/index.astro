---
import Build from '../components/beats/build.astro'
import Dispatch from '../components/beats/dispatch.astro'
import Groundwork from '../components/beats/groundwork.astro'
import Merge from '../components/beats/merge.astro'
import Plan from '../components/beats/plan.astro'
import Review from '../components/beats/review.astro'
import Fold from '../components/sections/fold.astro'
import QuickStart from '../components/sections/quick-start.astro'
import { bridge, site } from '../content/copy'
import Base from '../layouts/base.astro'
---

<Base title={site.title} description={site.description}>
  <Fold />
  <section class="bridge" id="how">
    <div class="bin">
      <p class="lead">{bridge}</p>
    </div>
  </section>
  <Groundwork />
  <Plan />
  <Dispatch />
  <Build />
  <Review />
  <Merge />
  <QuickStart />
</Base>
