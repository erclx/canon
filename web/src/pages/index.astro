---
import Board from '../components/sections/board/index.astro'
import Craft from '../components/sections/craft/index.astro'
import Drive from '../components/sections/drive/index.astro'
import Film from '../components/sections/film/index.astro'
import Guardrails from '../components/sections/guardrails/index.astro'
import Health from '../components/sections/health/index.astro'
import Opening from '../components/sections/opening/index.astro'
import Records from '../components/sections/records/index.astro'
import Roles from '../components/sections/roles/index.astro'
import Setup from '../components/sections/setup/index.astro'
import Try from '../components/sections/try/index.astro'
import Worktrees from '../components/sections/worktrees/index.astro'
import { site } from '../content/copy'
import Base from '../layouts/base.astro'
---

<Base title={site.title} description={site.description}>
  <Opening />
  <Roles class="split-right" />
  <Records class="banded" />
  <Craft />
  <Guardrails class="banded" />
  <Worktrees />
  <Film class="banded split-right" />
  <Board class="split-left" />
  <Drive class="banded split-right" />
  <Health class="split-left" />
  <Setup class="banded" />
  <Try />
</Base>
