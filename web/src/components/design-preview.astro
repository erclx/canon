---
import { designPreview } from '../content/copy'
import Panel from './panel.astro'

/**
 * Replaces what would otherwise be a screenshot of `canon/DESIGN.md`
 * rendered to HTML. The output is embedded live rather than captured, per
 * `internal/rules/claude/593-landing-page.md`'s "every image is generated,
 * never a screenshot pasted in", extended here to an iframe rather than a
 * raster since `#1581` also added an assertion that no `<img>` renders inside
 * `<main>`. `scripts/core/regen-web-previews.ts` writes the embedded page at
 * build time from the same source this repository's own design doc is read
 * from.
 */
---

<section
  data-reveal
  id="design-preview"
  class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-24"
>
  <h2>{designPreview.heading}</h2>
  <p>{designPreview.lede}</p>

  <Panel foot={designPreview.citation}>
    <iframe
      src="/previews/design-tokens/index.html"
      title="Design token preview"
      loading="lazy"
      class="h-[640px] w-full rounded-[var(--radius-panel)] border border-(--color-border)"
    ></iframe>
  </Panel>
</section>
