---
import mark from '../../../../assets/brand/mark.svg?raw'
import { nav, sections } from '../../content/copy'
import ChevronIcon from './chevron.svg'
import MoonIcon from './moon.svg'
import SunIcon from './sun.svg'
import './style.css'

/**
 * The fixed bar on the page's own grid ground: the mark back to the top, a
 * jump to each section, then Docs and GitHub after a thin rule, and the theme
 * toggle. Below 1100 it drops the jumps `sections` marks to fold, and below
 * 900 every jump, Docs, and GitHub fold into Menu, so focus order matches what
 * shows. Its soft rule shows only once the page scrolls.
 *
 * The section in view takes ink and the accent underline. The mark is inlined
 * from its source so the c inherits the bar's ink through `currentColor`, and
 * its pip takes `--pip`, the mark's own pair.
 */
const glyph = mark.replace(/<!--[\s\S]*?-->/, '').trim()
---

<header class="site-nav">
  <nav aria-label="Site">
    <a class="brand" href="#top" aria-label={nav.back}>
      <span class="glyph" aria-hidden="true" set:html={glyph} />
      <span>{nav.mark}</span>
    </a>
    <span class="links">
      {
        sections.map((section) => (
          <a
            class:list={['sl', { fold: section.fold }]}
            href={`#${section.id}`}
            data-section={section.id}
          >
            {section.label}
          </a>
        ))
      }
      <span class="nmw">
        <button
          type="button"
          class="nbtn"
          aria-expanded="false"
          aria-controls="nav-panel"
        >
          <span>{nav.menu}</span>
          <ChevronIcon class="chev" aria-hidden="true" />
        </button>
        <span class="npanel" id="nav-panel">
          {
            sections.map((section) => (
              <a href={`#${section.id}`} data-section={section.id}>
                {section.label}
              </a>
            ))
          }
          <span class="ndiv" aria-hidden="true"></span>
          <a class="pext" href={nav.docs.href}>{nav.docs.label}</a>
          <a class="pext" href={nav.github.href}>{nav.github.label}</a>
        </span>
      </span>
      <i class="sep" aria-hidden="true"></i>
      <a class="ext" href={nav.docs.href}>{nav.docs.label}</a>
      <a class="ext" href={nav.github.href}>{nav.github.label}</a>
      <button
        type="button"
        class="theme-toggle"
        aria-label={nav.toggle.toDark}
        data-to-dark={nav.toggle.toDark}
        data-to-light={nav.toggle.toLight}
      >
        <MoonIcon class="moon" aria-hidden="true" />
        <SunIcon class="sun" aria-hidden="true" />
      </button>
    </span>
  </nav>
</header>

<script src="./client.ts"></script>
