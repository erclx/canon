---
import mark from '../../../assets/brand/mark.svg?raw'
import { footer, nav } from '../content/copy'

/** One row of real destinations under the mark, then where the six steps' lines come from. */
const glyph = mark.replace(/<!--[\s\S]*?-->/, '').trim()
---

<footer class="foot">
  <div class="row-top">
    <span class="brand">
      <span class="glyph" aria-hidden="true" set:html={glyph} />
      {nav.mark}
    </span>
    <nav aria-label="Elsewhere">
      {footer.links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={footer.license.href}>{footer.license.label}</a>
    </nav>
  </div>
  <p class="note">{footer.note}</p>
</footer>

<style>
  .foot {
    max-width: var(--bin);
    margin: 0 auto;
    padding: 0 var(--space-lg) var(--space-2xl);
  }

  .row-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    padding-top: var(--space-xl);
    box-shadow: inset 0 1px 0 var(--ring);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-right: auto;
    font-size: var(--t4);
    font-weight: 600;
    color: var(--ink);
  }

  .glyph {
    display: flex;
  }

  .glyph :global(svg) {
    width: 18px;
    height: 18px;
  }

  .glyph :global(.pip) {
    fill: var(--pip);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }

  a {
    font-size: var(--t4);
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.16s var(--ease);
  }

  a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .note {
    margin: var(--space-lg) 0 0;
    max-width: 60ch;
    font-size: var(--t5);
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .brand {
      width: 100%;
    }
  }
</style>
