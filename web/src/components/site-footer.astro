---
import mark from '../../../assets/brand/mark.svg?raw'
import { footer, nav } from '../content/copy'

/** One row under a rule: the mark, then the real destinations a reader goes next. */
const glyph = mark.replace(/<!--[\s\S]*?-->/, '').trim()
---

<footer class="foot">
  <div class="in">
    <span class="brand">
      <span class="glyph" aria-hidden="true" set:html={glyph} />
      {nav.mark}
    </span>
    <nav aria-label="Project links">
      {footer.links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={footer.license.href}>{footer.license.label}</a>
    </nav>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    font-size: var(--size-body);
    color: var(--muted);
  }

  .in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    max-width: calc(var(--page-w) + var(--gutter) * 2);
    margin: 0 auto;
    padding: 32px var(--gutter) 48px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--ink);
    user-select: none;
  }

  .glyph {
    display: flex;
  }

  .glyph :global(svg) {
    width: 22px;
    height: 22px;
  }

  .glyph :global(.pip) {
    fill: var(--pip);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
  }

  a {
    color: var(--body);
    text-decoration: none;
    border-radius: var(--radius-chip);
  }

  a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .in {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 28px;
      padding-bottom: 40px;
    }
  }
</style>
