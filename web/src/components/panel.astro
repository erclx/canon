---
/**
 * The panel every converted section is drawn in.
 *
 * System A, picked on 2026-09-07 over a terminal-native and an editorial
 * alternative. The window chrome the committed frames carry is deliberately
 * absent: a capture needs it so a still reads as terminal output, and a page
 * that already draws its own surfaces reads it as a frame inside a frame,
 * which was one of the four legibility defects the treatment exists to fix.
 *
 * `foot` carries where the content came from. Every section states its own
 * provenance rather than the page asserting it once, which is what
 * `internal/rules/claude/landing-page.md` requires of a rendered count.
 */
interface Props {
  foot?: string
  columns?: boolean
}

const { foot, columns = false } = Astro.props
---

<div
  class="rounded-[var(--radius-panel)] border border-(--color-border) bg-(--color-surface) px-5 py-4"
>
  <div class={columns ? 'panel-columns' : ''}>
    <slot />
  </div>
  {
    foot && (
      <p class="m-0 mt-3 border-t border-(--color-border) pt-3 text-[length:var(--type-label-size)] text-(--color-muted)">
        {foot}
      </p>
    )
  }
</div>

<style>
  /*
   * A grid rather than CSS columns.
   *
   * `column-count` balances by height, which put five groups in the left
   * column and three in the right and left the two single-rule domains
   * stranded at the bottom of one side. A grid places them in order, so the
   * columns hold an equal number of groups whatever height each one runs to.
   */
  .panel-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
    align-content: start;
  }

  @media (max-width: 640px) {
    .panel-columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
