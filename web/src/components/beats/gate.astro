---
import { gate } from '../../content/copy'
import { readSession } from '../../lib/session'
import Band from './band.astro'

/**
 * The quoted line is read out of the planning rule at build time rather than
 * restated, so the page cannot claim a rule the repository stopped shipping.
 */
const { testFirst } = readSession()
---

<Band id="gate" head={gate.head} cap={gate.cap}>
  <div class="fig" id="fig-gate">
    <blockquote class="quote">
      <p>{testFirst}</p>
      <cite>{gate.cite}<span>{gate.citeNote}</span></cite>
    </blockquote>
    <ol class="pair">
      {
        gate.pair.map((step) => (
          <li>
            <b>{step.what}</b>
            <span>{step.how}</span>
          </li>
        ))
      }
    </ol>
    <p class="footnote">
      {gate.foot.before}<b>{gate.foot.verb}</b>{gate.foot.after}
    </p>
  </div>
</Band>

<style>
  .quote {
    margin: 0 0 var(--space-xl);
    padding: 0 0 0 var(--space-lg);
    box-shadow: inset 1px 0 0 var(--ring);
  }

  .quote p {
    margin: 0;
    font-size: var(--t4);
    color: var(--ink);
  }

  .quote cite {
    display: block;
    margin-top: var(--space-md);
    font-style: normal;
    color: var(--ink-faint);
  }

  .quote cite span {
    display: block;
  }

  .pair {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
    counter-reset: pair;
  }

  .pair li {
    counter-increment: pair;
    padding: var(--space-lg) 0 0;
    box-shadow: inset 0 1px 0 var(--ring);
  }

  .pair li::before {
    content: counter(pair);
    display: block;
    color: var(--ink-faint);
    margin-bottom: var(--space-sm);
  }

  .pair b {
    display: block;
    font-size: var(--t4);
    font-weight: 500;
    color: var(--ink);
  }

  .pair span {
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
