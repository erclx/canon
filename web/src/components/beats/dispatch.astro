---
import { steps } from '../../content/copy'
import { dispatch } from '../../content/trail'
import Figure from '../figure.astro'
import Group from '../sections/group.astro'
---

<Group id="dispatch" layout="wide" lead {...steps.dispatch}>
  <ol class="stack chat">
    {
      dispatch.messages.map((message) => (
        <li class="msg">
          <small>{message.who}</small>
          {message.text}
        </li>
      ))
    }
  </ol>
  <Figure
    title={dispatch.view.title}
    aside={dispatch.view.state}
    rows={dispatch.sessions}
    tight
  />
</Group>
