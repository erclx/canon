---
import { dispatch } from '../../content/copy'
import { readSession } from '../../lib/session'
import Band from './band.astro'

/**
 * The roster is the role skills that actually ship, each carrying the first
 * sentence of its own catalog description, so the figure is the repository's
 * dispatch rather than a drawing of one. It is the one shape on the page that
 * nests: the controller above the two sessions it launches.
 */
const { roles } = readSession()
const children = [
  { name: 'planner', ...dispatch.roles.planner, says: roles.planner },
  { name: 'worker', ...dispatch.roles.worker, says: roles.worker },
]
---

<Band id="dispatch" head={dispatch.head} cap={dispatch.cap}>
  <div class="fig" id="fig-dispatch">
    <div class="rail">
      <div class="controller">
        <span class="role">{dispatch.controller.who}</span>
        <b>{dispatch.controller.what}</b>
        <code>{dispatch.controller.skill}</code>
      </div>
      <ul class="launched">
        {
          children.map((child) => (
            <li>
              <span class="role">{child.name}</span>
              <b>{child.what}</b>
              <code>{child.skill}</code>
              <p>{child.says}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="footnote">{dispatch.foot}</p>
  </div>
</Band>

<style>
  .rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .controller,
  .launched li {
    padding: var(--space-lg);
    border-radius: var(--radius-frame);
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--ring);
  }

  .role {
    display: block;
    margin-bottom: var(--space-sm);
    color: var(--ink-faint);
  }

  .rail b {
    display: block;
    font-size: var(--t4);
    font-weight: 500;
    color: var(--ink);
  }

  .rail code {
    display: block;
    margin-top: var(--space-sm);
    color: var(--ink-faint);
  }

  .launched {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-2xl);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
    position: relative;
  }

  .launched::before {
    content: '';
    position: absolute;
    left: var(--space-md);
    top: calc(-1 * var(--space-lg));
    bottom: 50%;
    width: 1px;
    background: var(--ring);
  }

  .launched p {
    margin: var(--space-md) 0 0;
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .launched {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
