---
import { steps } from '../../content/copy'
import { merge } from '../../content/trail'
import Figure from '../figure.astro'
import Group from '../sections/group.astro'
---

<Group id="merge" layout="split" {...steps.merge}>
  <div class="stack">
    <Figure
      title={merge.terminal.title}
      aside={merge.terminal.where}
      rows={merge.results}
      tight
    >
      <p class="prompt mono">
        <span aria-hidden="true">$</span>{merge.command.text}
      </p>
    </Figure>
    <Figure
      title={merge.board.title}
      aside={merge.board.where}
      rows={merge.board.rows}
      tight
    />
  </div>
</Group>
