---
import { evidence, turns } from '../../content/copy'
import Turn from './turn.astro'

/**
 * Two real captures of one surface, base against head, of the pull request the
 * session depicts. A window mockup assembled from boxes was the alternative,
 * and a screenshot made of rectangles is a tell where two captures of the same
 * change answer the question with more force.
 */
---

<Turn id="evidence" {...turns.evidence}>
  <div class="fig" id="fig-evidence">
    <p class="fig-head">
      <code>{evidence.verb}</code><span class="aside">{evidence.by}</span><span
        class="aside pr">{evidence.pullRequest}</span
      >
    </p>
    <div class="pair">
      {
        evidence.captures.map((capture) => (
          <figure>
            <figcaption>
              <span>{capture.label}</span>
              <code>{capture.ref}</code>
            </figcaption>
            <img
              src={capture.file}
              alt={capture.alt}
              loading="lazy"
              width="900"
              height="413"
            />
          </figure>
        ))
      }
    </div>
    <p class="footnote">
      {evidence.foot.before}<b>{evidence.foot.verb}</b>{evidence.foot.after}
    </p>
  </div>
</Turn>

<style>
  .pr {
    margin-left: auto;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    color: var(--ink-faint);
  }

  img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-panel);
    box-shadow: inset 0 0 0 1px var(--ring);
    background: var(--card);
  }

  @media (max-width: 760px) {
    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>
