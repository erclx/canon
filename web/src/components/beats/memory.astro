---
import { memory } from '../../content/copy'
import Band from './band.astro'

/**
 * A router rather than a list: the memory rule states one test and two
 * destinations, and the test is the whole figure. `readSession` refuses the
 * build if the rule stops limiting the pen to what no context entry owns, so
 * this figure cannot outlive the claim it draws.
 */
---

<Band id="memory" head={memory.head} cap={memory.cap}>
  <div class="fig" id="fig-memory">
    <p class="fig-head">
      <code>{memory.skill}</code><span class="aside">{memory.when}</span>
    </p>
    <div class="router">
      <div class="rin"><b>{memory.input}</b></div>
      <ul class="rout">
        {
          memory.routes.map((route) => (
            <li>
              <span class="rq">{route.test}</span>
              <b>{route.where}</b>
              <p>{route.what}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="footnote">{memory.foot}</p>
  </div>
</Band>

<style>
  .router {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  /* A rail rather than a fill, since a chrome fill on a tinted ground is a box with no edge. */
  .rin {
    padding: var(--space-lg) 0 var(--space-lg) var(--space-lg);
    box-shadow: inset 2px 0 0 var(--ring);
  }

  .rin b,
  .rout b {
    font-size: var(--t4);
    font-weight: 500;
    color: var(--ink);
  }

  .rout {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .rout li {
    padding: var(--space-lg);
    border-radius: var(--radius-frame);
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--ring);
  }

  .rq {
    display: block;
    color: var(--ink-faint);
    margin-bottom: var(--space-sm);
  }

  .rout b {
    display: block;
  }

  .rout p {
    margin: var(--space-sm) 0 0;
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .router {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
