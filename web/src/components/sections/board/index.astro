---
import { board, boardScene } from '../../../content/copy'
import PauseButton from '../../pause-button/index.astro'
import { boardAfter } from './state'
import './style.css'

/**
 * The board an unattended run works overnight: three lanes, a row crossing
 * one lane a beat as the clock runs on, until it rests where the morning finds
 * it, with the one row that waits on you edged in the waiting color. The page
 * renders that resting state, which reduced motion keeps.
 */

interface Props {
  /** The shape `pages/index.astro` gives the section, read by `styles/global.css`. */
  class?: string
}

const { class: shape } = Astro.props
const rest = boardAfter(
  boardScene.rows,
  boardScene.moves,
  boardScene.moves.length,
)
---

<section class:list={['sec', shape]} id="board">
  <div class="sec-head">
    <h2>{board.head}</h2>
    <p>{board.lede}</p>
  </div>
  <div class="tray">
    <PauseButton />
    <div class="win bd">
      <div class="bh">
        <b>{boardScene.title}</b>
        <span class="since">· {boardScene.since}</span>
        <span class="clock">{boardScene.moves.at(-1)?.at}</span>
      </div>
      <div class="lanes">
        {
          boardScene.lanes.map((lane, index) => (
            <div class="lane">
              <p class="ln">{lane}</p>
              <ul role="list" data-lane={index}>
                {rest
                  .filter((row) => row.lane === index)
                  .map((row) => (
                    <li
                      class:list={['row', { wait: row.waiting }]}
                      data-name={row.name}
                    >
                      <span class="nm">{row.name}</span>
                      <span class="st">{row.line}</span>
                      <span class="wl sr-only">{boardScene.waitingLabel}</span>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <script
    type="application/json"
    class="board-data"
    set:html={JSON.stringify({
      start: boardScene.start,
      rows: boardScene.rows,
      moves: boardScene.moves,
    })}
  />
</section>

<script src="./client.ts"></script>
