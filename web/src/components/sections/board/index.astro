---
import { board, boardScene } from '../../../content/copy'
import type { BoardRow } from './state'
import { boardAfter } from './state'
import './style.css'

/**
 * The board twice: as you leave it at the night's start, and as you find it
 * when you come back, with the moves between them counted. The second board
 * replays the night once it comes into view, a row a beat under a bar that
 * fills across the night, with a replay beside it. The page renders where the
 * night rests, which reduced motion keeps until Replay is pressed, and the one
 * row that waits on you takes the waiting glyph and edge.
 */
const { rows, moves, lanes, start } = boardScene
const rest = boardAfter(rows, moves, moves.length)
const last = moves.at(-1)?.at ?? start
const boards: {
  kind: string
  label: string
  rows: readonly BoardRow[]
  stamp: string
}[] = [
  {
    kind: 'before',
    label: boardScene.before,
    rows,
    stamp: boardScene.stepOut(start),
  },
  {
    kind: 'after',
    label: boardScene.after,
    rows: rest,
    stamp: boardScene.comeBack(last),
  },
]
const data = {
  rows,
  moves,
  starts: boardScene.nightStarts(start),
  stamps: moves.map((move, index) =>
    index === moves.length - 1
      ? boardScene.comeBack(move.at)
      : boardScene.moved(move.at, move.name),
  ),
  waiting: boardScene.waitingLabel,
}
---

<section class="part" id="board">
  <div class="w">
    <div class="top">
      <h2>{board.head}</h2>
      <p class="lede">{board.lede}</p>
    </div>
    <div class="ba">
      {
        boards.map((side, index) => (
          <>
            {index === 1 && (
              <p class="mid note">{boardScene.movesLabel(moves.length)}</p>
            )}
            <figure class:list={['side', side.kind]} aria-label={side.label}>
              <p
                class="stamp note"
                aria-live={index === 1 ? 'polite' : undefined}
              >
                {side.stamp}
              </p>
              {index === 1 && (
                <div class="pg" aria-hidden="true">
                  <i />
                </div>
              )}
              <div class="bd">
                {lanes.map((lane, l) => (
                  <div class="ln">
                    <p class="lh note">{lane}</p>
                    <ul class="cards" role="list">
                      {side.rows
                        .filter((row) => row.lane === l)
                        .map((row) => (
                          <li class:list={['cd', { wt: row.waiting }]}>
                            <b>{row.name}</b>
                            <span>
                              {row.waiting && (
                                <i
                                  class="gl"
                                  role="img"
                                  aria-label={boardScene.waitingLabel}
                                >
                                  ◆
                                </i>
                              )}
                              {row.line}
                            </span>
                          </li>
                        ))}
                    </ul>
                  </div>
                ))}
              </div>
              {index === 1 && (
                <button type="button" class="drawn replay" hidden>
                  {boardScene.replay}
                </button>
              )}
            </figure>
          </>
        ))
      }
    </div>
  </div>
  <script
    type="application/json"
    id="board-data"
    set:html={JSON.stringify(data)}
  />
</section>

<script src="./client.ts"></script>
