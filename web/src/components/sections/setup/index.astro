---
import { setup, setupSession } from '../../../content/copy'
import PauseButton from '../../pause-button/index.astro'
import './style.css'

/**
 * A project's life with canon: four stages down one rule beside the setup
 * session, which they center on above 900, each a card saying when it runs,
 * the running one raised onto the window surface and the rule filling as
 * stages finish. The session loops once it scrolls into view and holds while
 * the reader hovers it or presses pause. A click on a stage plays on from it,
 * and the session holds one height so the page never jumps.
 */
const code = (text: string) => text.split('`')

interface Props {
  /** The shape `pages/index.astro` gives the section, read by `styles/global.css`. */
  class?: string
}

const { class: shape } = Astro.props
---

<section class:list={['sec', shape]} id="setup">
  <div class="sec-head">
    <h2>{setup.head}</h2>
    <p>{setup.lede}</p>
  </div>
  <div class="split">
    <div class="stages">
      {
        setup.stages.map((stage, index) => (
          <div class={`st${stage.skill ? ' skill' : ''}`} data-i={index}>
            <span class="when">{stage.when}</span>
            <h3>
              <button
                type="button"
                class="go"
                aria-label={setup.play(stage.name)}
              >
                {stage.name}
              </button>
            </h3>
            <p>
              {code(stage.line).map((part, k) =>
                k % 2 ? <code>{part}</code> : part,
              )}
            </p>
          </div>
        ))
      }
    </div>
    <div class="tray">
      <PauseButton />
      <div class="tx win" aria-hidden="true">
        <p class="cap">{setup.session}</p>
        <div class="log"></div>
      </div>
    </div>
  </div>
  <script
    type="application/json"
    class="setup-data"
    set:html={JSON.stringify(setupSession)}
  />
</section>

<script src="./client.ts"></script>
