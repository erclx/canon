---
import { evidence } from '../../../content/copy'
import { readReel } from '../../../lib/film'
import './style.css'

/**
 * One reel a real pull request carried, read with its number and address from
 * the stamp beside it. It rests on its opening frame and plays only on its
 * control, on a surface that stays dark in both themes since one recording
 * carries one theme.
 */
const reel = readReel()
---

<section class="part" id="evidence">
  <div class="w">
    <div class="top">
      <h2>{evidence.head}</h2>
      <p class="lede">{evidence.lede}</p>
    </div>
    <figure class="reel">
      <div class="screen">
        <img
          class="frame"
          src="/reel-still.webp"
          alt={evidence.still(reel.pullRequest)}
          width={reel.width}
          height={reel.height}
          decoding="async"
          data-still="/reel-still.webp"
          data-reel="/reel.webp"
        />
        <div class="bar">
          <button
            type="button"
            class="play"
            data-play={evidence.play}
            data-loading={evidence.loading}
            data-stop={evidence.stop}
            data-ms={Math.round(reel.seconds * 1000)}
          >
            <span class="glyph" aria-hidden="true"></span>
            <span class="label">{evidence.play}</span>
          </button>
          <span class="len">{evidence.length(reel.seconds)}</span>
        </div>
      </div>
      <figcaption>
        {evidence.posted}{' '}
        <a href={reel.address}>{evidence.link(reel.pullRequest)}</a>
      </figcaption>
    </figure>
  </div>
</section>

<script src="./client.ts"></script>
