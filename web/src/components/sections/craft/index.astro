---
import { craft } from '../../../content/copy'
import { practices } from '../../../content/practice'
import './style.css'

/**
 * One practice at a time: the source's own words set large, the link to the
 * address its ledger row cites, and beside them above 900 or under them below
 * it the rule those words became, with the skill file it sits in. A chip per practice skill swaps the pair.
 * Every pair is rendered and the unpicked ones hidden, so the page reads whole
 * before the script runs.
 */
---

<section class="part" id="craft">
  <div class="w">
    <div class="top">
      <h2>{craft.head}</h2>
      <p class="lede">{craft.lede}</p>
    </div>
    <div class="chips" role="group" aria-label={craft.pick}>
      {
        practices.map((practice, index) => (
          <button
            type="button"
            class="chip"
            data-i={index}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {practice.name}
          </button>
        ))
      }
    </div>
    <div class="pairs" aria-live="polite">
      {
        practices.map((practice, index) => (
          <div class="pair" data-i={index} hidden={index !== 0}>
            <p class="note">{craft.source}</p>
            <blockquote>“{practice.quote}”</blockquote>
            <a class="src" href={practice.url}>
              {practice.source} ↗
            </a>
            <p class="becomes note" aria-hidden="true">
              <span class="arw">↓</span> {craft.becomes}
            </p>
            <div class="rule ink">
              <p class="note">
                {craft.ruleIn}{' '}
                <a class="path" href={`${craft.repoBlob}${practice.ruleFile}`}>
                  {practice.ruleFile}
                </a>
              </p>
              <p class="text">{practice.rule}</p>
              <p class="note">{practice.loads}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script src="./client.ts"></script>
