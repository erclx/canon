---
import { fold } from '../../content/copy'
import { readFilmSeconds } from '../../lib/film'

/**
 * The claim, the two plugin commands, and the launch film. The film is one
 * `<video>` per theme, since a `prefers-color-scheme` source cannot follow the
 * theme toggle, and both start with `preload="none"` so a visit downloads only
 * the one the script below plays. Its length is read off the rendered MP4.
 */
const seconds = readFilmSeconds()
const films = [
  {
    theme: 'dark',
    src: '/assets/launch.mp4',
    poster: '/assets/launch-poster.png',
  },
  {
    theme: 'light',
    src: '/assets/launch-light.mp4',
    poster: '/assets/launch-poster-light.png',
  },
]
---

<section class="fold" id="top">
  <div class="bin">
    <h1>{fold.headline}</h1>
    <p class="lead">{fold.lead}</p>
    <div class="cmd">
      {
        fold.commands.map((command) => (
          <code>
            <span aria-hidden="true">$ </span>
            {command}
          </code>
        ))
      }
    </div>
    <p class="cta">
      <a class="btn btn-primary" href={fold.primary.href}
        >{fold.primary.label}</a
      >
      <a class="btn btn-text" href={fold.secondary.href}
        >{fold.secondary.label}</a
      >
    </p>
    <figure class="film" data-film data-state="poster">
      {
        films.map((film) => (
          <video
            class={`film-${film.theme}`}
            data-theme-film={film.theme}
            src={film.src}
            poster={film.poster}
            width="1280"
            height="800"
            preload="none"
            muted
            loop
            playsinline
            aria-label={fold.film.label}
          />
        ))
      }
      <button type="button" class="film-play" data-film-play>
        <span class="tri" aria-hidden="true"></span>{fold.film.play(seconds)}
      </button>
      <button
        type="button"
        class="film-pause"
        data-film-pause
        aria-pressed="false"
      >
        {fold.film.pause}
      </button>
    </figure>
  </div>
</section>

<script>
  /**
   * The film plays muted and looping inline at 640 pixels and up, unless the
   * reader prefers reduced motion. Anywhere else it waits on its poster, and
   * the play button opens it: full screen below 640, inline above it. The
   * pause button is the control WCAG 2.2.2 asks of anything moving past five
   * seconds. A theme flip stops the film it hides and starts the one it shows.
   */
  const figure = document.querySelector<HTMLElement>('[data-film]')
  const root = document.documentElement
  const wide = window.matchMedia('(min-width: 640px)')
  const still = window.matchMedia('(prefers-reduced-motion: reduce)')

  if (figure) {
    const films = [
      ...figure.querySelectorAll<HTMLVideoElement>('[data-theme-film]'),
    ]
    const play = figure.querySelector<HTMLButtonElement>('[data-film-play]')
    const pause = figure.querySelector<HTMLButtonElement>('[data-film-pause]')
    let paused = false

    const current = () =>
      films.find(
        (film) => film.dataset.themeFilm === (root.dataset.theme ?? 'dark'),
      )

    const setState = (state: 'poster' | 'playing') => {
      figure.dataset.state = state
    }

    const start = (film: HTMLVideoElement) => {
      film.play().then(
        () => setState('playing'),
        () => setState('poster'),
      )
    }

    const stopOthers = (keep: HTMLVideoElement | undefined) => {
      for (const film of films) {
        if (film !== keep && !film.paused) film.pause()
      }
    }

    const sync = () => {
      const film = current()
      stopOthers(film)
      if (!film) return
      if (wide.matches && !still.matches && !paused) {
        start(film)
      } else if (figure.dataset.state === 'playing' && !paused) {
        start(film)
      } else {
        film.pause()
        setState('poster')
      }
    }

    play?.addEventListener('click', () => {
      const film = current()
      if (!film) return
      paused = false
      pause?.setAttribute('aria-pressed', 'false')
      if (!wide.matches) {
        film.controls = true
        const enter =
          film.requestFullscreen?.bind(film) ??
          (
            film as HTMLVideoElement & {
              webkitEnterFullscreen?: () => void
            }
          ).webkitEnterFullscreen?.bind(film)
        Promise.resolve(enter?.()).catch(() => undefined)
      }
      start(film)
    })

    pause?.addEventListener('click', () => {
      const film = current()
      if (!film) return
      paused = !paused
      pause.setAttribute('aria-pressed', String(paused))
      if (paused) film.pause()
      else start(film)
    })

    /** Leaving full screen on a phone returns the film to its poster. */
    document.addEventListener('fullscreenchange', () => {
      if (document.fullscreenElement || wide.matches) return
      for (const film of films) {
        film.controls = false
        film.pause()
      }
      setState('poster')
    })

    new MutationObserver(sync).observe(root, {
      attributes: true,
      attributeFilter: ['data-theme'],
    })
    wide.addEventListener('change', sync)
    still.addEventListener('change', sync)
    sync()
  }
</script>
