---
import { tryIt } from '../../content/copy'

/**
 * The quiet install: who canon expects, the three commands on the tray with
 * one copy control, then the first run. The
 * copy control shows on hover or focus, and always on a touch screen.
 */
const code = (text: string) => text.split('`')
---

<section class="sec" id="try">
  <div class="sec-head">
    <h2>{tryIt.head}</h2>
    <p>{tryIt.lede}</p>
  </div>
  <div class="tray">
    <div class="block" data-commands={tryIt.commands.join('\n')}>
      {tryIt.commands.map((command) => <code>{command}</code>)}
      <button
        type="button"
        class="copy"
        aria-label={tryIt.copy.label}
        data-tip={tryIt.copy.tip}
        data-done={tryIt.copy.done}
        data-status={tryIt.copy.status}
      >
        <svg
          class="ic"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect width="13" height="13" x="9" y="9" rx="2"></rect><path
            d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
          ></path></svg
        >
        <svg
          class="ok"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg
        >
        <span class="tip" aria-hidden="true">{tryIt.copy.tip}</span>
      </button>
      <span class="sr-only" role="status" aria-live="polite"></span>
    </div>
  </div>
  <p class="first">
    {code(tryIt.first).map((part, k) => (k % 2 ? <code>{part}</code> : part))}
  </p>
</section>

<style is:global>
  #try .sec-head p {
    max-width: 60ch;
  }

  #try .tray {
    margin-top: 44px;
  }

  #try .block {
    position: relative;
    padding: 20px 68px 20px 24px;
    background: var(--win);
    border-radius: var(--radius-frame);
    box-shadow: var(--shadow-window);
    font-family: var(--mono);
    font-size: var(--size-body);
    line-height: 1.5;
    color: var(--ink);
  }

  #try .block code {
    display: block;
    padding: 3px 0 3px 2ch;
    font-family: inherit;
    font-size: inherit;
    text-indent: -2ch;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  #try .block code::before {
    content: '$ ';
    color: var(--muted);
    user-select: none;
  }

  #try .copy {
    position: absolute;
    top: 13px;
    right: 13px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-action);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity var(--duration-feedback) var(--ease-standard),
      background-color var(--duration-feedback) var(--ease-standard),
      color var(--duration-feedback) var(--ease-standard);
  }

  #try .block:hover .copy,
  #try .copy:focus-visible,
  #try .copy.done {
    opacity: 1;
  }

  #try .copy:hover {
    background: var(--hover);
    color: var(--ink);
  }

  #try .copy svg {
    width: 17px;
    height: 17px;
  }

  #try .copy .ok,
  #try .copy.done .ic {
    display: none;
  }

  #try .copy.done .ok {
    display: block;
  }

  #try .copy.done {
    color: var(--ink);
  }

  #try .tip {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 50%;
    padding: 7px 9px;
    border-radius: var(--radius-action);
    background: var(--ink);
    font-family: var(--sans);
    font-size: var(--size-small);
    line-height: 1;
    color: var(--ground);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateX(50%);
    transition: opacity var(--duration-feedback) var(--ease-standard);
  }

  #try .copy:hover .tip,
  #try .copy:focus-visible .tip,
  #try .copy.done .tip {
    opacity: 1;
  }

  @media (hover: none) {
    #try .copy {
      opacity: 1;
    }
  }

  #try .first {
    max-width: 72ch;
    margin: 28px 0 0;
    font-size: var(--size-body);
    line-height: 1.6;
    color: var(--body);
  }

  @media (max-width: 640px) {
    #try .tray {
      margin-top: 32px;
    }

    #try .block {
      padding: 14px 52px 14px 16px;
      font-size: var(--size-small);
    }

    #try .copy {
      top: 8px;
      right: 8px;
    }
  }
</style>

<script>
  const block = document.querySelector<HTMLElement>('#try .block')
  const button = block?.querySelector<HTMLButtonElement>('.copy')
  const tip = button?.querySelector<HTMLElement>('.tip')
  const status = block?.querySelector<HTMLElement>('[role="status"]')
  let reset: ReturnType<typeof setTimeout> | undefined

  button?.addEventListener('click', () => {
    void navigator.clipboard
      ?.writeText(block?.dataset.commands ?? '')
      .catch(() => {
        // A refused clipboard still shows the state, since the commands stay on screen to copy by hand.
      })
    button.classList.add('done')
    if (tip) tip.textContent = button.dataset.done ?? ''
    if (status) status.textContent = button.dataset.status ?? ''
    clearTimeout(reset)
    reset = setTimeout(() => {
      button.classList.remove('done')
      if (tip) tip.textContent = button.dataset.tip ?? ''
      if (status) status.textContent = ''
    }, 1600)
  })
</script>
