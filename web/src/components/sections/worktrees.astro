---
import { worktreeBranches, worktrees } from '../../content/copy'

/**
 * A branch graph over time under the shared `.canon/` band: main along the
 * bottom, three branches forking at different moments and running up to a
 * shared now line, the oldest on the top lane so no line crosses, and an
 * earlier branch drawn merged back. It draws itself in once on view, at its
 * real pixel size, and on a phone the labels list under a full-width graph.
 */
const { lanes } = worktreeBranches
---

<section class="sec" id="worktrees">
  <div class="sec-head">
    <h2>{worktrees.head}</h2>
    <p>{worktrees.lede}</p>
  </div>
  <div class="tray">
    <div class="card">
      <div class="band">
        <span class="ic"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path
              d="M3 7.5A1.5 1.5 0 0 1 4.5 6H9l2 2h8.5A1.5 1.5 0 0 1 21 9.5v8A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5Z"
            ></path></svg
          ></span
        >
        <span class="nm">{worktrees.band.name}</span>
        <span class="dirs">{worktrees.band.dirs}</span>
        <span class="sh">{worktrees.band.shared}</span>
      </div>
      <div class="tl play">
        <div class="plot">
          <svg aria-hidden="true"></svg>
          <span class="nowlab">{worktrees.now}</span>
          <span class="mlab">{worktrees.main}</span>
          <span class="merged">{worktreeBranches.merged.label}</span>
        </div>
        <div class="labs">
          {
            lanes.map((lane, index) => (
              <div class="lab" style={`--i:${index}`}>
                <p class="b">{lane.branch}</p>
                <p class="s">{lane.session}</p>
                <p class="l">{lane.line}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <p class="under">{worktrees.under}</p>
  </div>
  <script
    type="application/json"
    class="worktrees-data"
    set:html={JSON.stringify(worktreeBranches)}
  />
</section>

<style is:global>
  #worktrees {
    --trunk: var(--line);
  }

  [data-theme='dark'] #worktrees {
    --trunk: color-mix(in srgb, var(--ink) 15%, var(--win));
  }

  #worktrees .tray {
    margin-top: 52px;
  }

  #worktrees .card {
    padding: 28px 32px 26px;
    background: var(--win);
    border-radius: var(--radius-frame);
    box-shadow: var(--shadow-window);
  }

  #worktrees .band {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--radius-panel);
    background: var(--band);
  }

  #worktrees .ic {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-action);
    background: var(--win);
    color: var(--accent);
    box-shadow: var(--shadow-ring);
  }

  #worktrees .ic svg {
    width: 17px;
    height: 17px;
  }

  #worktrees .nm {
    font-family: var(--mono);
    font-size: var(--size-body);
    font-weight: 500;
    color: var(--ink);
  }

  #worktrees .dirs,
  #worktrees .sh {
    font-size: var(--size-small);
    color: var(--muted);
  }

  #worktrees .dirs {
    font-family: var(--mono);
  }

  #worktrees .sh {
    margin-left: auto;
  }

  #worktrees .under {
    max-width: 70ch;
    margin: 20px 0 0;
    font-size: var(--size-body);
    line-height: var(--type-body-lh);
    color: var(--body);
    text-wrap: pretty;
  }

  #worktrees .tl {
    --lh: 76px;
    --top: 30px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 0 20px;
    margin-top: 20px;
    user-select: none;
  }

  #worktrees .plot {
    position: relative;
    height: calc(var(--top) + var(--lh) * 3 + 54px);
  }

  #worktrees .plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  #worktrees .labs {
    position: relative;
  }

  #worktrees .lab {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--top) + var(--lh) * var(--i) - 10px);
  }

  #worktrees .lab p {
    margin: 0;
  }

  #worktrees .lab .b {
    font-size: var(--size-body);
    font-weight: 600;
    color: var(--ink);
  }

  #worktrees .lab .s {
    margin-top: 1px;
    font-family: var(--mono);
    font-size: var(--size-view-small);
    color: var(--muted);
  }

  #worktrees .lab .l {
    margin-top: 3px;
    font-size: var(--size-small);
    line-height: 1.4;
    color: var(--body);
  }

  #worktrees :is(.nowlab, .mlab, .merged) {
    position: absolute;
    font-family: var(--mono);
    font-size: var(--size-view-small);
    color: var(--muted);
  }

  #worktrees .nowlab {
    top: 0;
    transform: translateX(-50%);
  }

  #worktrees .main {
    fill: none;
    stroke: var(--trunk);
    stroke-width: 5;
    stroke-linecap: round;
  }

  #worktrees .br {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #worktrees .br.old {
    stroke: var(--muted);
    opacity: 0.55;
  }

  #worktrees .now {
    stroke: var(--muted);
    stroke-width: 1.2;
    stroke-dasharray: 3 5;
    opacity: 0.6;
  }

  #worktrees .nd {
    fill: var(--win);
    stroke: var(--accent);
    stroke-width: 3.2;
  }

  #worktrees .nd.old {
    stroke: var(--muted);
    opacity: 0.7;
  }

  #worktrees .nd.fork {
    stroke: var(--muted);
  }

  #worktrees .nd.head {
    fill: var(--accent);
    stroke: var(--win);
    stroke-width: 3;
  }

  /* Drawn in once on view: main, then each branch, its commits, its head, then the labels. */
  #worktrees .br,
  #worktrees .nd {
    --t: 0s;
  }

  #worktrees .play .br,
  #worktrees .play .main {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  #worktrees .play :is(.nd, .lab, .nowlab, .now) {
    opacity: 0;
  }

  #worktrees .go .main {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--duration-draw) var(--ease-draw);
  }

  #worktrees .go .br {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--duration-draw) var(--ease-draw) var(--t);
  }

  #worktrees .go .nd {
    opacity: 1;
    transition: opacity var(--duration-fade) var(--ease-standard) var(--t);
  }

  #worktrees .go .nd.old {
    opacity: 0.7;
  }

  #worktrees .go .lab {
    opacity: 1;
    transition: opacity var(--duration-fade) var(--ease-standard)
      calc(1.4s + var(--i) * 0.15s);
  }

  #worktrees .go .now {
    opacity: 0.6;
    transition: opacity var(--duration-fade) var(--ease-standard) 1.6s;
  }

  #worktrees .go .nowlab {
    opacity: 1;
    transition: opacity var(--duration-fade) var(--ease-standard) 1.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    #worktrees .play .br,
    #worktrees .play .main {
      stroke-dashoffset: 0;
    }

    #worktrees .play :is(.nd, .lab, .nowlab) {
      opacity: 1;
    }

    #worktrees .play .now {
      opacity: 0.6;
    }

    #worktrees .play .nd.old {
      opacity: 0.7;
    }
  }

  @media (max-width: 900px) {
    #worktrees .tray {
      margin-top: 40px;
    }

    #worktrees .tl {
      --lh: 84px;
      grid-template-columns: minmax(0, 1fr) 220px;
    }

    #worktrees .band {
      flex-wrap: wrap;
    }

    #worktrees .sh {
      width: 100%;
      margin-left: 0;
    }

    #worktrees .card {
      padding: 20px;
    }
  }

  @media (max-width: 640px) {
    #worktrees .tray {
      margin-top: 32px;
    }

    #worktrees .tl {
      --lh: 44px;
      --top: 26px;
      grid-template-columns: minmax(0, 1fr);
    }

    #worktrees .labs {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: 22px;
    }

    #worktrees .lab {
      position: static;
    }

    #worktrees .lab .b::before {
      content: '';
      display: inline-block;
      width: 9px;
      height: 9px;
      margin-right: 8px;
      border-radius: 50%;
      background: var(--accent);
      vertical-align: 1px;
    }

    #worktrees .lab :is(.s, .l) {
      padding-left: 17px;
    }

    #worktrees .merged {
      display: none;
    }

    #worktrees .card {
      padding: 16px;
    }

    #worktrees .dirs {
      width: 100%;
    }
  }
</style>

<script>
  interface Lane {
    fork: number
    commits: number[]
  }
  interface Graph {
    now: number
    lanes: Lane[]
    merged: { fork: number; merge: number; commits: number[] }
  }

  const section = document.getElementById('worktrees')
  const source = section?.querySelector('.worktrees-data')
  const timeline = section?.querySelector<HTMLElement>('.tl')
  const plot = timeline?.querySelector<HTMLElement>('.plot')
  const svg = plot?.querySelector('svg')

  if (source?.textContent && timeline && plot && svg) {
    const graph = JSON.parse(source.textContent) as Graph
    const nowLabel = plot.querySelector<HTMLElement>('.nowlab')
    const mainLabel = plot.querySelector<HTMLElement>('.mlab')
    const mergedLabel = plot.querySelector<HTMLElement>('.merged')

    /** Redrawn at the plot's real pixel size, so strokes and dots never scale. */
    function draw() {
      const W = plot!.clientWidth
      const H = plot!.clientHeight
      const styles = getComputedStyle(timeline!)
      const lh = parseFloat(styles.getPropertyValue('--lh'))
      const top = parseFloat(styles.getPropertyValue('--top'))
      const my = top + lh * 3
      const X = (f: number) => 8 + f * (W - 16)
      const ly = (i: number) => top + lh * i
      svg!.setAttribute('viewBox', `0 0 ${W} ${H}`)
      const curve = (x0: number, y0: number, x1: number, y1: number) => {
        const k = Math.min(46, (x1 - x0) * 0.5)
        return `C ${x0 + k} ${y0}, ${x0 + k * 0.3} ${y1}, ${x0 + k * 1.2} ${y1}`
      }
      let h = `<line class="now" x1="${X(graph.now)}" y1="${top - 12}" x2="${X(graph.now)}" y2="${my + 8}"/>`
      h += `<path class="main" pathLength="1" d="M${X(0)} ${my} H${X(1)}"/>`
      graph.lanes.forEach((lane, i) => {
        const y = ly(i)
        const t = i * 0.35 + 0.3
        if (i === graph.lanes.length - 1) {
          const m = graph.merged
          const f = X(m.fork)
          const g = X(m.merge)
          const k = Math.min(40, (g - f) * 0.35)
          h += `<path class="br old" style="--t:.2s" pathLength="1" d="M${f} ${my} C ${f + k} ${my}, ${f + k * 0.2} ${y}, ${f + k * 1.1} ${y} H ${g - k * 1.1} C ${g - k * 0.2} ${y}, ${g - k} ${my}, ${g} ${my}"/>`
          m.commits.forEach(
            (c) =>
              (h += `<circle class="nd old" style="--t:.6s" cx="${X(c)}" cy="${y}" r="5"/>`),
          )
          h += `<circle class="nd old fork" style="--t:.2s" cx="${f}" cy="${my}" r="5.5"/><circle class="nd old" style="--t:.9s" cx="${g}" cy="${my}" r="5.5"/>`
          if (mergedLabel) {
            mergedLabel.style.left = `${f}px`
            mergedLabel.style.top = `${my + 14}px`
          }
        }
        const f = X(lane.fork)
        const n = X(graph.now)
        h += `<path class="br" style="--t:${t}s" pathLength="1" d="M${f} ${my} ${curve(f, my, n, y)} H ${n}"/>`
        h += `<circle class="nd fork" style="--t:${t}s" cx="${f}" cy="${my}" r="6"/>`
        lane.commits.forEach(
          (c, j) =>
            (h += `<circle class="nd" style="--t:${t + 0.3 + j * 0.15}s" cx="${X(c)}" cy="${y}" r="6"/>`),
        )
        h += `<circle class="nd head" style="--t:${t + 0.8}s" cx="${n}" cy="${y}" r="8.5"/>`
      })
      svg!.innerHTML = h
      if (nowLabel) nowLabel.style.left = `${X(graph.now)}px`
      if (mainLabel) {
        mainLabel.style.top = `${my + 14}px`
        mainLabel.style.right = '0'
      }
    }

    draw()
    window.addEventListener('resize', draw)
    void document.fonts?.ready.then(draw)
    const observer = new IntersectionObserver(
      (entries) => {
        if (
          entries.some((e) => e.isIntersecting && e.intersectionRatio >= 0.35)
        ) {
          observer.disconnect()
          requestAnimationFrame(() =>
            requestAnimationFrame(() => timeline.classList.add('go')),
          )
        }
      },
      { threshold: [0.35] },
    )
    observer.observe(timeline)
  }
</script>
