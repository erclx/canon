---
import { health as copy } from '../../../content/copy'
import { readHealth } from '../../../lib/health'
import './style.css'

/**
 * This repository's own audits, read at build time: the three longest
 * functions as bars against the function checkpoint, the file and comment
 * counts under them, then the pull requests merged each week as a sparkline,
 * the week in progress in the accent. The bars grow past the checkpoint once
 * the ranking comes into view, and reduced motion shows them grown.
 */
const health = readHealth()
const format = (count: number) => count.toLocaleString('en-US')
/** The track runs a little past the longest function, so its count sits clear of the end. */
const scale = (health.functions[0]?.lines ?? 1) * 1.08
const share = (lines: number) => `${((lines / scale) * 100).toFixed(1)}%`
const most = Math.max(...health.weeks.map((week) => week.merges))
const first = health.weeks[0]?.label ?? ''
const last = health.weeks.at(-1)?.label ?? ''
---

<section class="part" id="health">
  <div class="w">
    <div class="top">
      <h2>{copy.head}</h2>
      <p class="lede">{copy.lede}</p>
    </div>
    <div class="rank ink">
      <p class="cmd note">
        {copy.view.audit} · {copy.view.longest}
        {copy.view.checkpoint(health.checkpoint)}
      </p>
      <ol class="rows" role="list">
        {
          health.functions.map((fn) => (
            <li class="rk">
              <p class="nm">
                <span>{fn.file}</span>
                <span class="fn">{fn.name}</span>
              </p>
              <div
                class="trk"
                style={`--w:${share(fn.lines)};--ck:${share(health.checkpoint)}`}
              >
                <i aria-hidden="true" />
                <span class="ck" aria-hidden="true" />
                <b>
                  {format(fn.lines)}
                  {fn.past && (
                    <span class="sr-only">
                      {copy.view.past(health.checkpoint)}
                    </span>
                  )}
                </b>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="leg note">
        <span class="ckk" aria-hidden="true"></span>
        {copy.view.checkpoint(health.checkpoint)} · {
          copy.view.read(health.files)
        }
        · {copy.view.longFiles(health.longFiles, health.fileLimit)} · {
          copy.view.dense(health.denseFiles, health.shareCap)
        }
      </p>
    </div>
    <figure class="hist">
      <p class="cmd note">{copy.view.history}</p>
      <ol class="sp" role="list" aria-hidden="true">
        {
          health.weeks.map((week, index) => (
            <li
              class:list={{ cur: index === health.weeks.length - 1 }}
              style={`--h:${week.merges / most}`}
            />
          ))
        }
      </ol>
      <figcaption class="note">
        {health.weeks.map((week) => format(week.merges)).join(' · ')}
        {copy.view.weeks(first, last)}
        <span class="sr-only">. {copy.view.caption(health.to)}</span>
      </figcaption>
    </figure>
  </div>
</section>

<script src="./client.ts"></script>
