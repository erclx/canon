---
import { craft } from '../../content/copy'
import { craftScenes, practices } from '../../content/practice'

/**
 * The eight practice skills beside a Claude Code window that loops through
 * seven requests in the list's order, each loading its skill, the skill lit
 * before its request types. A pick fades the window to the scene that loads
 * that skill and holds the pick until it loads. One skill shows at a time
 * behind a row of pickers, beside the window above 900 and under it below, so
 * a pick never plays its scene off screen.
 */
const data = {
  skills: practices.map((p) => ({
    name: p.name,
    loads: p.loads,
    rule: p.rule,
    ruleFile: p.ruleFile,
    source: p.source,
    quote: p.quote,
  })),
  scenes: craftScenes,
}
const first = practices[0]
---

<section class="sec" id="craft">
  <div class="top">
    <div class="sec-head">
      <h2>{craft.head}</h2>
      <p>{craft.lede}</p>
    </div>
    <div class="tray">
      <div class="win" aria-hidden="true">
        <div class="win-bar"><i></i><i></i><i></i><span>claude</span></div>
        <div class="log"></div>
        <div class="inp">
          <div class="rule"></div>
          <div class="line">
            <span class="g">❯</span><span
              ><span class="typed"></span><span class="cur"></span></span
            >
          </div>
          <div class="rule"></div>
        </div>
      </div>
    </div>
    <div class="pair">
      <div class="picks" role="group" aria-label="Practice skills">
        {
          practices.map((p, index) => (
            <button
              type="button"
              class="pick"
              aria-pressed={index === 0 ? 'true' : 'false'}
              data-i={index}
            >
              {p.name}
            </button>
          ))
        }
      </div>
      <div class="panes">
        <div class="pane">
          <p class="lbl">
            {craft.ruleIn}
            <code class="p-file">{first?.ruleFile}</code>
          </p>
          <p class="rule p-rule">{first?.rule}</p>
          <span class="loads p-loads">{first?.loads}</span>
        </div>
        <div class="pane">
          <p class="lbl">{craft.source}</p>
          <p class="srcname p-source">{first?.source}</p>
          <p class="quote"><q class="p-quote">{first?.quote}</q></p>
        </div>
      </div>
    </div>
  </div>
  <script
    type="application/json"
    class="craft-data"
    set:html={JSON.stringify(data)}
  />
</section>

<style is:global>
  #craft q {
    quotes: '\201C' '\201D';
  }

  #craft .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 464px;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'head tray'
      'pair tray';
    column-gap: 48px;
  }

  #craft .sec-head {
    grid-area: head;
  }

  #craft .top > .tray {
    grid-area: tray;
    display: flex;
  }

  #craft .win {
    flex: 1;
    min-height: 380px;
    user-select: none;
  }

  #craft .log {
    flex: 1;
    min-height: 0;
    padding: 16px 22px 0;
    overflow: hidden;
    transition: opacity var(--duration-fade) var(--ease-standard);
  }

  #craft .log.hide {
    opacity: 0;
  }

  #craft .log .ask {
    margin: 0 -22px 12px;
    padding: 7px 22px;
  }

  #craft .log .tool {
    position: relative;
    padding-left: 20px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #craft .log .tool::before {
    content: '\25CF';
    position: absolute;
    left: 0;
    top: 0;
    font-size: var(--size-view-small);
    color: var(--muted);
  }

  #craft .log .tool.sk::before {
    color: var(--accent);
  }

  #craft .log .tool b {
    font-weight: 500;
  }

  #craft .log .res {
    margin-bottom: 6px;
    padding-left: 24px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #craft .log .res::before {
    content: '\23BF  ';
    white-space: pre;
  }

  #craft .inp {
    flex: none;
    padding: 0 22px 14px;
  }

  #craft .inp .rule {
    height: 1px;
    background: var(--line);
  }

  #craft .inp .line {
    display: flex;
    gap: 10px;
    padding: 9px 0;
    white-space: pre-wrap;
    color: var(--ink);
  }

  #craft .inp .line .g {
    flex: none;
    color: var(--muted);
  }

  #craft .name {
    font-family: var(--mono);
    font-size: var(--size-body);
    font-weight: 600;
    color: var(--ink);
  }

  #craft .loads {
    display: block;
    margin-top: 4px;
    font-size: var(--size-small);
    line-height: var(--type-small-lh);
    color: var(--muted);
  }

  #craft .rule {
    margin: 0;
    font-size: var(--size-body);
    line-height: var(--type-body-lh);
    color: var(--ink);
    text-wrap: pretty;
  }

  #craft .srcname {
    margin: 0;
    font-size: var(--size-small);
    color: var(--muted);
  }

  #craft .quote {
    margin: 4px 0 0;
    font-size: var(--size-body);
    line-height: var(--type-body-lh);
    color: var(--body);
    text-wrap: pretty;
  }

  #craft .pair {
    grid-area: pair;
    margin-top: 36px;
  }

  #craft .panes {
    display: grid;
    gap: 12px;
    margin-top: 20px;
    align-content: start;
  }

  #craft .pane {
    padding: 22px 24px;
    background: var(--tray);
    border: 1px solid var(--edge);
    border-radius: var(--radius-panel);
  }

  #craft .pane .lbl {
    margin: 0 0 8px;
    font-size: var(--size-small);
    color: var(--muted);
  }

  #craft .pane .loads {
    margin-top: 10px;
  }

  #craft .pane .quote {
    margin-top: 6px;
    color: var(--ink);
  }

  #craft .pick {
    font-family: var(--mono);
  }

  @media (max-width: 1240px) {
    #craft .top {
      grid-template-columns: minmax(0, 1fr) 440px;
    }
  }

  @media (max-width: 900px) {
    #craft .top {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        'head'
        'tray'
        'pair';
      row-gap: 28px;
    }

    #craft .win {
      min-height: 0;
      height: 364px;
    }

    #craft .pair {
      margin-top: 12px;
    }
  }

  @media (min-width: 641px) and (max-width: 900px) {
    #craft .panes {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    #craft .win {
      min-height: 0;
      height: 332px;
    }

    #craft .log {
      padding: 12px 14px 0;
    }

    #craft .log .ask {
      margin: 0 -14px 10px;
      padding: 6px 14px;
    }

    #craft .inp {
      padding: 0 14px 12px;
    }

    #craft .pane {
      padding: 18px;
    }
  }
</style>

<script>
  import { escapeHtml, holdOn, pacer, reducedMotion } from '../../lib/scene'

  interface Skill {
    name: string
    loads: string
    rule: string
    ruleFile: string
    source: string
    quote: string
  }
  interface Scene {
    ask: string
    lines: [string, string, string][]
  }

  const section = document.getElementById('craft')
  const source = section?.querySelector('.craft-data')
  const log = section?.querySelector<HTMLElement>('.log')
  const typed = section?.querySelector<HTMLElement>('.typed')

  if (section && source?.textContent && log && typed) {
    const { skills, scenes } = JSON.parse(source.textContent) as {
      skills: Skill[]
      scenes: Scene[]
    }
    const picks = [...section.querySelectorAll<HTMLButtonElement>('.pick')]
    const panes = section.querySelector<HTMLElement>('.panes')
    const pair = section.querySelector<HTMLElement>('.pair')
    const field = (name: string) =>
      section.querySelector<HTMLElement>(`.p-${name}`)
    const pace = pacer(holdOn(section.querySelector('.win')))
    const still = reducedMotion()
    const indexOf = (name: string) => skills.findIndex((s) => s.name === name)
    const sceneOf = (name: string) =>
      scenes.findIndex((scene) =>
        scene.lines.some(
          ([tool, arg]) => tool === 'Skill' && arg === `canon:${name}`,
        ),
      )
    let held = -1

    function fill(index: number) {
      const skill = skills[index]
      if (!skill) return
      const set = (name: string, text: string) => {
        const node = field(name)
        if (node) node.textContent = text
      }
      set('file', skill.ruleFile)
      set('rule', skill.rule)
      set('loads', skill.loads)
      set('source', skill.source)
      set('quote', skill.quote)
    }

    /** Exactly one skill is lit at a time. */
    function only(index: number) {
      picks.forEach((pick) =>
        pick.setAttribute(
          'aria-pressed',
          String(Number(pick.dataset.i) === index),
        ),
      )
      fill(index)
    }

    /** The panes keep the height of the tallest skill, so a pick never moves the page. */
    function settle() {
      if (!panes || !pair) return
      panes.style.minHeight = ''
      const shown = Math.max(
        0,
        picks.findIndex((p) => p.getAttribute('aria-pressed') === 'true'),
      )
      let tallest = 0
      skills.forEach((_, i) => {
        fill(i)
        tallest = Math.max(tallest, panes.offsetHeight)
      })
      fill(shown)
      panes.style.minHeight = `${tallest}px`
    }

    function light(arg: string) {
      const index = indexOf(arg.replace('canon:', ''))
      if (index < 0) return
      if (held >= 0 && index !== held) return
      held = -1
      only(index)
    }

    function add(className: string, html: string) {
      const node = document.createElement('div')
      node.className = className
      node.innerHTML = html
      log!.append(node)
    }
    const askLine = (text: string) =>
      add('ask', `<span class="g">❯</span><span>${escapeHtml(text)}</span>`)
    const toolLine = (tool: string, arg: string) =>
      add(
        `tool${tool === 'Skill' ? ' sk' : ''}`,
        `<b>${tool}</b>(${escapeHtml(arg)})`,
      )

    function render(scene: Scene) {
      log!.replaceChildren()
      typed!.textContent = ''
      askLine(scene.ask)
      scene.lines.forEach(([tool, arg, result]) => {
        toolLine(tool, arg)
        add('res', escapeHtml(result))
        if (tool === 'Skill') light(arg)
      })
    }

    async function run(from: number, generation: number, fade: boolean) {
      if (fade) {
        log!.classList.add('hide')
        if (!(await pace.wait(320, generation))) return
        log!.replaceChildren()
        log!.classList.remove('hide')
      }
      for (let k = from; ; k++) {
        const scene = scenes[k % scenes.length]
        if (!scene) return
        const lead = scene.lines.find(
          ([tool, arg]) =>
            tool === 'Skill' && indexOf(arg.replace('canon:', '')) >= 0,
        )
        if (lead) light(lead[1])
        for (let c = 1; c <= scene.ask.length; c++) {
          typed!.textContent = scene.ask.slice(0, c)
          if (!(await pace.wait(26, generation))) return
        }
        if (
          !(await pace.wait(
            Math.min(1400, 500 + scene.ask.length * 12),
            generation,
          ))
        )
          return
        typed!.textContent = ''
        log!.replaceChildren()
        askLine(scene.ask)
        for (const [tool, arg, result] of scene.lines) {
          if (!(await pace.wait(650, generation))) return
          toolLine(tool, arg)
          if (!(await pace.wait(250, generation))) return
          add('res', escapeHtml(result))
          if (tool === 'Skill') light(arg)
        }
        if (!(await pace.wait(2600, generation))) return
        log!.classList.add('hide')
        if (!(await pace.wait(320, generation))) return
        held = -1
        log!.replaceChildren()
        log!.classList.remove('hide')
      }
    }

    function jump(index: number) {
      const skill = skills[index]
      if (!skill) return
      const k = Math.max(0, sceneOf(skill.name))
      const generation = pace.next()
      held = index
      only(index)
      typed!.textContent = ''
      const scene = scenes[k]
      if (still) {
        if (scene) render(scene)
        return
      }
      void run(k, generation, true)
    }

    picks.forEach((pick) =>
      pick.addEventListener('click', () => jump(Number(pick.dataset.i))),
    )

    only(0)
    settle()
    window.addEventListener('resize', settle)
    void document.fonts?.ready.then(settle)

    if (still) {
      const scene = scenes[0]
      if (scene) render(scene)
    } else {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect()
          void run(0, pace.next(), false)
        }
      })
      const win = section.querySelector('.win')
      if (win) observer.observe(win)
    }
  }
</script>
