---
import { guardrails } from '../../../content/copy'
import './style.css'

/**
 * Four stamps in the order the parts fire, each under when it fires and the
 * real name it runs under, its verdict set large over the action it caught.
 * The merge's refusal is the one stamp in the accent, as the live refusal.
 * The stamps land one after another as the grid comes into view, since the
 * order is the claim, and reduced motion shows all four landed.
 */
const last = guardrails.parts.length - 1
---

<section class="part" id="guardrails">
  <div class="w">
    <div class="top">
      <h2>{guardrails.head}</h2>
      <p class="lede">{guardrails.lede}</p>
    </div>
    <ol class="grid">
      {
        guardrails.parts.map((part, index) => (
          <li class:list={['stamp', { hot: index === last }]}>
            <p class="hd">
              <span class="note">{part.when}</span>
              <code class="sm">{part.real}</code>
            </p>
            <p class="big">{part.verdict}</p>
            <p class="act">{part.act}</p>
            <p class="res">{part.res}</p>
            <p class="nm">
              <b>{part.name}</b> · {part.line}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script src="./client.ts"></script>
