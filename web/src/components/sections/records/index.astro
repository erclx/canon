---
import { records as copy } from '../../../content/copy'
import { records } from '../../../content/records'
import ChevronIcon from './chevron.svg'
import './style.css'

/**
 * The twelve records as a stack of sheets the page's scroll pages through.
 * The stage pins below the nav for one step of scroll per sheet, then lets go.
 * The pickers jump to a sheet, a phone reads them as one picker menu, and a
 * skip link passes the whole stack. Under reduced motion the stage does not
 * pin and the pickers swap sheets in place.
 *
 * Each sheet is an editor or a browser window with a rendered and a source
 * view, and its checkboxes and file tabs work. An editor sheet carries an
 * explorer, drawn from its breadcrumb, that lights the file its tabs have open.
 */

interface Entry {
  name: string
  depth: number
  /** The tab index of a file entry, absent on a folder. */
  file?: number
  on?: boolean
}

/** The project's top folders, and the record folders inside `.canon/`. */
const ROOTS = ['.canon', 'canon', 'src', 'docs']
const RECORD_DIRS = [
  'compact',
  'groundwork',
  'intake',
  'plans',
  'review',
  'tasks',
]

/**
 * An editor sheet's explorer: the top folders, the one its breadcrumb runs
 * through opened down to the files its tabs hold, the open tab's file lit.
 * Every tab of a sheet sits in one folder, so the first breadcrumb stands for
 * them all.
 */
function explorerOf(html: string): Entry[] {
  const crumb = /<div class="crumb">([\s\S]*?)<\/div>/.exec(html)?.[1] ?? ''
  const dirs = crumb
    .replace(/<[^>]+>/g, '')
    .split('›')
    .map((part) => part.trim())
    .filter(Boolean)
    .slice(0, -1)
  const tabs = [
    ...html.matchAll(/<button[^>]*class="ftab"[\s\S]*?<\/button\s*>/g),
  ]
  const files = tabs.map(
    (tab) => /<span>([^<]+)<\/span>/.exec(tab[0])?.[1] ?? '',
  )
  const open = Math.max(
    0,
    tabs.findIndex((tab) => tab[0].includes('aria-selected="true"')),
  )
  const [root, folder] = dirs
  const tree: Entry[] = []
  for (const top of ROOTS) {
    tree.push({ name: top, depth: 0 })
    if (top !== root || !folder) continue
    const siblings =
      top === '.canon' && RECORD_DIRS.includes(folder) ? RECORD_DIRS : [folder]
    for (const sibling of siblings) {
      tree.push({ name: `${sibling}/`, depth: 1 })
      if (sibling !== folder) continue
      dirs
        .slice(2)
        .forEach((dir, i) => tree.push({ name: `${dir}/`, depth: i + 2 }))
      files.forEach((name, file) =>
        tree.push({ name, depth: dirs.length, file, on: file === open }),
      )
    }
  }
  return tree
}
---

<section class="sec" id="records">
  <div class="sec-head">
    <h2>{copy.head}</h2>
    <p>{copy.lede}</p>
  </div>
  <a class="skip-stack" href="#records-after">{copy.skip}</a>
  <div class="scrolly">
    <div class="stick">
      <div class="tray">
        <div class="pk">
          <button
            type="button"
            class="pk-btn"
            aria-expanded="false"
            aria-controls="records-pk-list"
          >
            <span class="pk-name">{records[0]?.name}</span>
            <ChevronIcon aria-hidden="true" />
          </button>
          <span class="pk-n"></span>
          <ul class="pk-list" id="records-pk-list" hidden>
            {
              records.map((sheet, index) => (
                <li>
                  <button type="button" data-j={index}>
                    {sheet.name}
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="tabs picks" role="group" aria-label="Records">
          {
            records.map((sheet, index) => (
              <button
                type="button"
                class="pick"
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-i={index}
              >
                {sheet.name}
              </button>
            ))
          }
        </div>
        <div class="pile">
          {
            records.map((sheet, index) => (
              <article
                class={`sheet ${sheet.kind}`}
                data-i={index}
                data-name={sheet.name}
                data-by={sheet.by}
              >
                {sheet.kind === 'ed' && (
                  <div class="wbar" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                  </div>
                )}
                <div class="in" set:html={sheet.html} />
                {sheet.kind === 'ed' && (
                  <aside class="explorer" aria-hidden="true">
                    {explorerOf(sheet.html).map((entry) => (
                      <div
                        class:list={{ on: entry.on, top: entry.depth === 0 }}
                        data-f={entry.file}
                        style={`--d:${entry.depth}`}
                      >
                        {entry.name}
                      </div>
                    ))}
                  </aside>
                )}
              </article>
            ))
          }
        </div>
        <div class="foot">
          <p class="cap" aria-live="polite"></p>
          <span class="count"></span>
        </div>
      </div>
    </div>
  </div>
  <div id="records-after" tabindex="-1"></div>
</section>

<script src="./client.ts"></script>
