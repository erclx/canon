---
import { records as copy } from '../../../content/copy'
import { records, renderedPage } from '../../../content/records'
import './style.css'

/**
 * The records as rendered pages fanned out, the picked one at the front with
 * the two either side of it fanned behind. A chip per record brings its page
 * to the front. The fan is laid out for the Plan at build, so the page reads
 * whole before the script runs, and a phone shows the front page alone.
 */
const FRONT = 2
const pages = records.map((record) => ({
  name: record.name,
  ...renderedPage(record),
}))
const half = Math.floor(pages.length / 2)
/** How far a page sits from the front, wrapping so each side holds the nearest. */
const offset = (index: number) =>
  ((index - FRONT + pages.length + half) % pages.length) - half
---

<section class="part" id="records">
  <div class="w split">
    <div>
      <h2>{copy.head}</h2>
      <p class="lede">{copy.lede}</p>
      <div class="chips" role="group" aria-label={copy.pick}>
        {
          pages.map((page, index) => (
            <button
              type="button"
              class="chip"
              data-i={index}
              aria-pressed={index === FRONT ? 'true' : 'false'}
            >
              {page.name}
            </button>
          ))
        }
      </div>
    </div>
    <div class="fan">
      {
        pages.map((page, index) => (
          <article
            class="sheet ink"
            data-i={index}
            data-at={offset(index)}
            aria-hidden={index === FRONT ? undefined : 'true'}
            aria-label={page.name}
          >
            <p class="path">{page.path}</p>
            <div class="md" set:html={page.body} />
          </article>
        ))
      }
    </div>
  </div>
</section>

<script src="./client.ts"></script>
