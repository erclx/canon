---
import { worktreeCards, worktrees } from '../../../content/copy'
import FolderIcon from './folder.svg'
import './style.css'

/**
 * Three worktrees side by side, each a card naming its folder, its branch, and
 * what its session is doing, each joined down into the one shared `.canon/`
 * band they all read and write. On a phone the cards stack over the band with
 * no joins.
 *
 * One card a beat steps its status line on, pulses its dot, and drops a dot
 * down its join that lights the folder the step writes, holding while the
 * reader holds the card and standing still under reduced motion. Each card
 * rests on its second step.
 */
const REST = 1
---

<section class="sec" id="worktrees">
  <div class="sec-head">
    <h2>{worktrees.head}</h2>
    <p>{worktrees.lede}</p>
  </div>
  <div class="tray">
    <div class="card">
      <ul class="wts" role="list">
        {
          worktreeCards.map((card) => (
            <li class="wt">
              <p class="p">{card.path}</p>
              <p class="b">
                <span class="dot" aria-hidden="true" />
                {card.branch}
              </p>
              <p class="l">
                {card.steps.map((step, index) => (
                  <span class:list={{ on: index === REST }}>{step.line}</span>
                ))}
              </p>
              <span class="drop" aria-hidden="true" />
            </li>
          ))
        }
      </ul>
      <div class="band">
        <span class="ic"><FolderIcon aria-hidden="true" /></span>
        <span class="nm">{worktrees.band.name}</span>
        <span class="dirs">
          {
            worktrees.band.dirs.map((dir, index) => (
              <>
                {index > 0 && ' · '}
                <span data-dir={dir}>{dir}</span>
              </>
            ))
          }
        </span>
        <span class="sh">{worktrees.band.shared}</span>
      </div>
    </div>
  </div>
  <script
    type="application/json"
    class="worktrees-data"
    set:html={JSON.stringify({
      rest: REST,
      cards: worktreeCards.map((card) => card.steps.map((step) => step.dir)),
    })}
  />
</section>

<script src="./client.ts"></script>
