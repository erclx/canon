---
import { worktreeCards, worktrees } from '../../../content/copy'
import './style.css'

/**
 * A branch graph: three worktrees forking off main together, each track ending
 * on its head commit beside a card naming its folder, its branch, where its
 * session stands, and the shared folder that step writes. Under them sits the
 * one `.canon/` record every worktree reads and writes, its written folders
 * lit. The branches draw out of main once as the graph comes into view, and
 * reduced motion shows them drawn.
 */
const written = new Set(worktreeCards.map((card) => card.dir))
---

<section class="part" id="worktrees">
  <div class="w">
    <h2>{worktrees.head}</h2>
    <p class="lede">{worktrees.lede}</p>
    <div class="graph">
      <div class="main"><span class="note">{worktrees.main}</span></div>
      <ul class="lanes" role="list">
        {
          worktreeCards.map((card) => (
            <li class="lane">
              <span class="fork" aria-hidden="true" />
              <span class="track" aria-hidden="true">
                <i />
                <i />
                <i class="head" />
              </span>
              <div class="meta">
                <p class="note">{card.path}</p>
                <b>{card.branch}</b>
                <p class="l">
                  {card.line}{' '}
                  <span class="wr">
                    {worktrees.writes} {card.dir}
                  </span>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="floor ink">
      <b>{worktrees.band.name}</b>
      {
        worktrees.band.dirs.map((dir) => (
          <span class:list={['d', { on: written.has(dir) }]}>{dir}</span>
        ))
      }
      <span class="sh">{worktrees.band.shared}</span>
    </div>
  </div>
</section>

<script src="./client.ts"></script>
