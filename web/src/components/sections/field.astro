---
import { field } from '../../content/copy'
import { readSession, usedNames } from '../../lib/session'

/**
 * Every command and every skill, with the ones the session used lit. The names
 * and both totals are build-time reads, the command names off `canon --help`
 * and the skills off `canon claude skills list`, so each heading's count is the
 * length of the list under it. The skills sit under the group their
 * `metadata.family` names, in the family vocabulary's order, each with its
 * "When to use" text from the skill map, and `skillGroups` refuses a skill the
 * map does not carry or files under another group. The lit names are authored and checked against the
 * catalog, so a rename fails the build rather than lighting nothing.
 */
const session = readSession()
const skillNames = session.skills.map((skill) => skill.name)
const commandNames = [...session.commands].sort()
const firstSkill = session.skillGroups[0]?.skills[0]?.name
const fields = [
  {
    names: commandNames,
    lit: usedNames(field.usedCommands, commandNames, 'commands'),
    label: field.commands(commandNames.length, field.usedCommands.length),
    kind: 'commands',
  },
  {
    names: skillNames,
    lit: usedNames(field.usedSkills, skillNames, 'skills'),
    label: field.skills(skillNames.length, field.usedSkills.length),
    kind: 'skills',
  },
]
---

<section class="coda" id="field">
  <div class="bin">
    <p class="head">{field.head}</p>
    <p class="cap">{field.cap}</p>
    <div class="fields">
      {
        fields.map((entry) => (
          <div class="field" data-field={entry.kind}>
            <p class="label">
              {entry.label.total}
              <i>{entry.label.used}</i>
            </p>
            {entry.kind === 'skills' ? (
              session.skillGroups.map((group) => (
                <div class="group">
                  <h3 class="group-name">{group.group}</h3>
                  <ul
                    class="names"
                    style={`--rows: ${Math.ceil(group.skills.length / 4)}`}
                  >
                    {group.skills.map((skill) => (
                      <li
                        class:list={{ on: entry.lit.has(skill.name) }}
                        tabindex={skill.name === firstSkill ? '0' : '-1'}
                        aria-describedby={`usage-${skill.name}`}
                      >
                        {skill.name}
                        <span class="usage" id={`usage-${skill.name}`}>
                          {skill.usage}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            ) : (
              <ul
                class="names"
                style={`--rows: ${Math.ceil(entry.names.length / 4)}`}
              >
                {entry.names.map((name) => (
                  <li class:list={{ on: entry.lit.has(name) }}>{name}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // A revealed usage line has to be closable without moving the pointer or
  // focus (WCAG 1.4.13), so Escape marks the entry it belongs to, and the mark
  // lifts once that entry loses both hover and focus.
  const skills = document.querySelectorAll<HTMLElement>(
    '[data-field="skills"] li',
  )
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    for (const skill of skills) {
      if (skill.matches(':hover, :focus')) skill.dataset.dismissed = ''
    }
  })
  // The field is one tab stop, and the arrow keys walk the names in reading
  // order, so a keyboard reader passes the field without crossing every skill.
  const names = [...skills]

  // The group's grid fills down each column above 900px and across each row
  // below it, so the neighbor in a direction comes from the computed layout at
  // the current width. A step that leaves the group falls back to reading order.
  function neighbor(skill: HTMLElement, key: string): HTMLElement | undefined {
    const list = skill.parentElement
    if (!list) return undefined
    const items = [...list.children] as HTMLElement[]
    const style = getComputedStyle(list)
    const isColumnFlow = style.gridAutoFlow.startsWith('column')
    const columns = style.gridTemplateColumns.split(' ').length
    const rows = style.gridTemplateRows.split(' ').length
    const index = items.indexOf(skill)
    // The length of the line whose cells follow one another in the DOM.
    const lane = isColumnFlow ? rows : columns
    const isVertical = key === 'ArrowDown' || key === 'ArrowUp'
    const sign = key === 'ArrowDown' || key === 'ArrowRight' ? 1 : -1
    const isAlongLane = isColumnFlow === isVertical
    if (!isAlongLane) return items[index + sign * lane]
    const position = (index % lane) + sign
    if (position < 0 || position >= lane) return undefined
    return items[index + sign]
  }

  for (const [index, skill] of names.entries()) {
    const lift = () => {
      if (!skill.matches(':hover, :focus')) delete skill.dataset.dismissed
    }
    skill.addEventListener('mouseleave', lift)
    skill.addEventListener('blur', lift)
    skill.addEventListener('focus', () => {
      for (const other of names) other.tabIndex = other === skill ? 0 : -1
    })
    skill.addEventListener('keydown', (event) => {
      const forward = event.key === 'ArrowRight' || event.key === 'ArrowDown'
      const backward = event.key === 'ArrowLeft' || event.key === 'ArrowUp'
      if (!forward && !backward) return
      const next =
        neighbor(skill, event.key) ?? names[index + (forward ? 1 : -1)]
      if (!next) return
      event.preventDefault()
      next.focus()
    })
  }
</script>

<style>
  .coda {
    padding: var(--space-2xl) 0;
  }

  .head,
  .cap {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .head {
    max-width: 28ch;
  }

  .cap {
    max-width: 52ch;
    margin-bottom: var(--space-xl);
  }

  .fields {
    display: grid;
    gap: var(--space-2xl);
  }

  /*
   * width:100% is load-bearing: margin:auto alone makes a grid item shrink to
   * its content, which sized a field of short command names narrower than a
   * field of long skill names.
   */
  .field {
    width: 100%;
  }

  .label {
    margin: 0 0 var(--space-lg);
    padding-bottom: var(--space-md);
    box-shadow: inset 0 -1px 0 var(--ring);
    font-size: var(--t5);
    color: var(--ink);
  }

  .label i {
    font-style: normal;
    color: var(--ink-faint);
    margin-left: var(--space-md);
  }

  /*
   * Fixed tracks, one width for both fields, so a short command name and a long
   * skill name still produce two tables that align. The track is the longest
   * name on either field, and the count and the gap carry the ladder below.
   */
  .names {
    list-style: none;
    padding: 0 var(--space-2xl);
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(var(--rows), auto);
    grid-template-columns: repeat(4, 10.5rem);
    justify-content: center;
    gap: var(--space-sm) var(--space-2xl);
    font-size: var(--t5);
  }

  .names li {
    color: var(--ink-faint);
    padding: var(--space-xs) 0;
  }

  .group + .group {
    margin-top: var(--space-xl);
  }

  .group-name {
    margin: 0 0 var(--space-sm);
    text-align: center;
    font-size: var(--t5);
    font-weight: 500;
    color: var(--ink);
  }

  /*
   * The usage line is revealed on hover, focus, and tap rather than printed
   * under every name, which keeps the field near the height of the name grid.
   * It is anchored to the group's list, so its width never depends on which
   * column the name sits in and it cannot run off a 320 screen.
   */
  .group .names {
    position: relative;
  }

  .group li {
    cursor: default;
  }

  .usage {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    margin-top: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--ring);
    color: var(--ink);
    font-weight: 400;
    font-size: var(--t6);
  }

  .group li:hover .usage,
  .group li:focus .usage {
    display: block;
  }

  .group li[data-dismissed] .usage {
    display: none;
  }

  /* Full ink at weight 500 against a faint sibling carries the distinction alone. */
  .names li.on {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 1040px) {
    .names {
      column-gap: var(--space-xl);
      padding: 0;
    }
  }

  @media (max-width: 900px) {
    .names {
      grid-template-columns: repeat(3, 10.5rem);
      grid-template-rows: none;
      grid-auto-flow: row;
      column-gap: var(--space-2xl);
    }
  }

  @media (max-width: 768px) {
    .names {
      column-gap: var(--space-lg);
    }
  }

  @media (max-width: 640px) {
    .names {
      grid-template-columns: repeat(2, 10.5rem);
      column-gap: var(--space-2xl);
    }
  }

  @media (max-width: 520px) {
    .names {
      column-gap: var(--space-lg);
    }
  }

  /*
   * Two fractional columns rather than one fixed track: a 10.5rem track cannot
   * fit twice here, and one column of eighty rows is worse than a few long
   * names wrapping.
   */
  @media (max-width: 430px) {
    .names {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
