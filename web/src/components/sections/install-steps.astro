---
import { install } from '../../content/copy'

/**
 * Three equal cards, the page's one instance of that shape, left on purpose:
 * three parallel install routes are the one place where three equal things are
 * three equal things.
 */
---

<section class="start" id="start">
  <div class="bin">
    <p class="head">{install.head}</p>
    <p class="cap">{install.cap}</p>
    <ol class="steps">
      {
        install.steps.map((step) => (
          <li>
            <b>{step.title}</b>
            <p>{step.body}</p>
            {step.commands.map((command) => (
              <code>{command}</code>
            ))}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .start {
    background: linear-gradient(
      var(--ground) 0,
      var(--tint) 14%,
      var(--tint) 86%,
      var(--ground) 100%
    );
    padding: var(--space-3xl) 0;
  }

  .head,
  .cap {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .head {
    max-width: 28ch;
  }

  .cap {
    max-width: 52ch;
    margin-bottom: var(--space-xl);
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .steps li {
    counter-increment: step;
    padding: var(--space-lg);
    border-radius: var(--radius-frame);
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--ring);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .steps b {
    font-size: var(--t4);
    font-weight: 500;
    color: var(--ink);
  }

  .steps b::before {
    content: counter(step);
    display: block;
    font-size: var(--t5);
    color: var(--ink-faint);
    margin-bottom: var(--space-sm);
  }

  .steps p {
    margin: 0;
    font-size: var(--t5);
    color: var(--ink-soft);
    flex: 1;
  }

  .steps code {
    font-size: var(--t5);
    color: var(--ink);
    background: var(--tint);
    border-radius: var(--radius-action);
    padding: var(--space-sm) var(--space-md);
    overflow-wrap: anywhere;
  }

  /*
   * A 1fr track floors at its min-content, which here is the card padding plus
   * its longest unbreakable string, so the row overflowed rather than shrinking
   * until it collapsed.
   */
  @media (max-width: 768px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
