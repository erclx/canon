---
import { fold } from '../../content/copy'
import {
  completed,
  menuFlow,
  opening,
  pinned,
  pool,
  steps,
} from '../../content/sessions'
import { readSkills } from '../../lib/skills'

/**
 * The claim, its lede, and Claude Code's agent view on the tray. The view runs
 * one event a tick, completing, answering, and dispatching sessions, and its
 * prompt takes typing, opening the canon skill menu on `/` and shell mode on
 * `!`. The menu reads the catalog at build time.
 */
const data = {
  pool,
  steps,
  pinned,
  completed,
  opening,
  flow: menuFlow,
  skills: readSkills(),
  noMatch: fold.view.noMatch,
  shellHint: fold.view.shellHint,
}
const [before, middle, last] = fold.parts
---

<section class="sec" id="top">
  <div class="hero">
    <h1>
      {before}
      <span class="ico doc" aria-hidden="true"
        ><svg viewBox="0 0 40 40" fill="none"
          ><rect
            x="9"
            y="5"
            width="22"
            height="30"
            rx="4"
            stroke="currentColor"
            stroke-width="2.4"></rect><path
            d="M14 13h12M14 19h12M14 25h7"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"></path><rect
            class="fill"
            x="25"
            y="23"
            width="7"
            height="7"
            rx="1.6"></rect></svg
        ></span
      >
      {middle}
      <span class="ico mg" aria-hidden="true"
        ><svg viewBox="0 0 40 40" fill="none"
          ><circle
            cx="12"
            cy="9"
            r="3.6"
            stroke="currentColor"
            stroke-width="2.6"></circle><circle
            cx="12"
            cy="31"
            r="3.6"
            stroke="currentColor"
            stroke-width="2.6"></circle><circle
            cx="29"
            cy="20"
            r="3.6"
            stroke="currentColor"
            stroke-width="2.6"></circle><path
            d="M12 12.6v14.8M12 12.6c0 7 6 7.4 13.4 7.4"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"></path></svg
        ></span
      >
      {last}
    </h1>
    <p>{fold.lead}</p>
  </div>
  <div class="tray">
    <div class="win term">
      <div class="win-bar">
        <i></i><i></i><i></i><span>{fold.view.title}</span>
      </div>
      <div class="av">
        <div class="cnts" id="av-counts"></div>
        <div class="lst" id="av-list"></div>
        <div class="prompt">
          <label class="ask-line">
            <span class="p">❯</span>
            <span class="fld">
              <input
                id="av-ask"
                type="text"
                placeholder=" "
                aria-label={fold.view.askLabel}
                autocomplete="off"
                spellcheck="false"
                maxlength="120"
                role="combobox"
                aria-autocomplete="list"
                aria-controls="av-menu"
                aria-expanded="false"
              />
              <span class="c"></span>
              <span class="ph">{fold.view.hint}</span>
              <span class="mz" aria-hidden="true">xxxxxxxxxxxxxxxxxxxx</span>
            </span>
          </label>
          <div
            class="menu"
            id="av-menu"
            role="listbox"
            aria-label={fold.view.menuLabel}
            hidden
          >
          </div>
        </div>
      </div>
    </div>
  </div>
  <script
    type="application/json"
    id="av-data"
    set:html={JSON.stringify(data)}
  />
</section>

<style is:global>
  #top {
    padding-top: 88px;
    padding-bottom: 80px;
  }

  #top .hero {
    text-align: center;
  }

  #top h1 {
    max-width: 1060px;
    margin: 0 auto;
    font-size: var(--type-hero-size);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 600;
    color: var(--ink);
  }

  #top .ico {
    position: relative;
    top: -0.06em;
    display: inline-grid;
    place-items: center;
    width: 78px;
    height: 78px;
    margin: 0 6px;
    border-radius: 20px;
    vertical-align: middle;
    box-shadow: var(--shadow-window);
  }

  #top .ico svg {
    width: 40px;
    height: 40px;
  }

  #top .ico.doc {
    background: var(--win);
    color: var(--ink);
  }

  #top .ico.doc .fill {
    fill: var(--accent);
  }

  #top .ico.mg {
    background: var(--accent);
    color: var(--color-light-window);
  }

  #top .hero p {
    max-width: 52ch;
    margin: 32px auto 0;
    font-size: var(--type-lede-size);
    line-height: var(--type-lede-lh);
    color: var(--muted);
  }

  #top .tray {
    max-width: var(--page-w);
    margin: 88px auto 0;
    padding: 44px 40px;
  }

  #top .term {
    max-width: 1040px;
    margin: 0 auto;
  }

  #top .win-bar {
    height: 44px;
  }

  #top .win-bar i {
    top: 16px;
  }

  #top .win-bar i:nth-child(1) {
    left: 16px;
  }

  #top .win-bar i:nth-child(2) {
    left: 36px;
  }

  #top .win-bar i:nth-child(3) {
    left: 56px;
  }

  #top .av {
    position: relative;
    padding: 22px 28px 0;
  }

  #top .cnts {
    color: var(--muted);
  }

  #top .cnts b {
    font-weight: 500;
    color: var(--ink);
  }

  #top .lst {
    position: relative;
    height: 404px;
    margin-top: 14px;
    overflow: hidden;
  }

  #top .lst .g,
  #top .lst .r {
    position: absolute;
    left: 0;
    right: 0;
    transition:
      top var(--duration-move) var(--ease-standard) 300ms,
      opacity var(--duration-fade) var(--ease-standard);
  }

  #top .lst .g {
    font-family: var(--sans);
    font-size: var(--size-small);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  #top .lst .r {
    isolation: isolate;
    display: grid;
    grid-template-columns: 22px 360px minmax(0, 1fr) 46px;
    column-gap: 18px;
    align-items: center;
    height: 30px;
    white-space: nowrap;
  }

  #top .lst .r > span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #top .lst .r.enter,
  #top .lst .r.arriving {
    transition:
      top 0s,
      opacity var(--duration-fade) var(--ease-standard) 750ms;
  }

  #top .lst .r.enter,
  #top .lst .r.leave {
    opacity: 0;
  }

  #top .lst .r::before {
    content: '';
    position: absolute;
    inset: 1px -10px;
    z-index: -1;
    border-radius: var(--radius-action);
    background: var(--hover);
    opacity: 0;
    transition: opacity var(--duration-feedback) var(--ease-standard);
    pointer-events: none;
  }

  #top .lst .r.hot::before {
    opacity: 1;
  }

  #top .lst .r.hot .n {
    color: var(--ink);
  }

  #top .lst .r.hot .d,
  #top .lst .r.hot .t {
    color: var(--body);
  }

  #top .lst .s {
    display: inline-block;
    width: 16px;
    text-align: center;
    color: var(--accent);
  }

  #top .lst .s.sp::after {
    content: '✻';
    animation: av-glyph 1.2s steps(1) infinite;
  }

  #top .lst .s.wt {
    color: var(--color-waiting);
    animation: av-pulse 1.4s ease-in-out infinite;
  }

  #top .lst .s.dn {
    color: var(--color-success);
  }

  #top .lst .s.old {
    color: var(--muted);
  }

  #top .lst .n {
    font-weight: 500;
    color: var(--body);
  }

  #top .lst .r.pin .n {
    color: var(--ink);
  }

  #top .lst .d,
  #top .lst .t {
    color: var(--muted);
  }

  #top .lst .t {
    text-align: right;
  }

  #top .lst .r.flash .d {
    animation: av-flash 0.9s ease;
  }

  #top .lst .under {
    filter: opacity(0);
  }

  @keyframes av-glyph {
    0% {
      content: '·';
    }
    16.6% {
      content: '✢';
    }
    33.3% {
      content: '✳';
    }
    50% {
      content: '✶';
    }
    66.6% {
      content: '✻';
    }
    83.3% {
      content: '✽';
    }
  }

  @keyframes av-pulse {
    50% {
      opacity: 0.35;
    }
  }

  @keyframes av-flash {
    0% {
      opacity: 0.2;
    }
    100% {
      opacity: 1;
    }
  }

  #top .prompt {
    position: relative;
    margin: 0 -28px;
    padding: 18px 28px 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  #top .ask-line {
    display: flex;
    align-items: center;
    gap: 11px;
    cursor: text;
  }

  #top .ask-line .p {
    flex: none;
    color: var(--ink);
  }

  #top .ask-line:focus-within .p {
    color: var(--accent);
  }

  /* The input draws no outline of its own, since the block caret stands in for the text caret, so its field carries the ring. */
  #top .fld:has(input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: var(--radius-action);
  }

  #top .fld {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  #top .fld input {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    color: var(--ink);
    caret-color: transparent;
  }

  #top .fld input::placeholder {
    color: transparent;
  }

  #top .fld .c {
    position: absolute;
    left: 0;
    top: 50%;
    width: 9px;
    height: 17px;
    margin-top: -9px;
    background: var(--color-light-window);
    mix-blend-mode: difference;
    pointer-events: none;
  }

  #top .fld .mz {
    position: absolute;
    visibility: hidden;
    white-space: pre;
  }

  #top .fld .ph {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
    color: var(--muted);
    pointer-events: none;
  }

  #top .fld input:not(:placeholder-shown) ~ .ph {
    display: none;
  }

  #top .fld input:not(:placeholder-shown):not(:focus) ~ .c {
    display: none;
  }

  /* Shell mode takes the accent on the mark, the hint, and the rule. */
  #top .prompt.shell {
    border-top-color: var(--accent);
  }

  #top .prompt.shell .p,
  #top .prompt.shell .ph {
    color: var(--accent);
  }

  /* The menu opens upward over the list, so the window never grows. */
  #top .menu {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 11px);
    z-index: 5;
    max-height: 172px;
    padding: 4px 28px 0;
    overflow: hidden;
    background: var(--win);
  }

  #top .menu[hidden] {
    display: none;
  }

  #top .menu .mi {
    display: grid;
    grid-template-columns: 22px 360px minmax(0, 1fr);
    column-gap: 18px;
    align-items: center;
    height: 28px;
    white-space: nowrap;
    cursor: pointer;
  }

  #top .menu .mk {
    color: transparent;
  }

  #top .menu .mn,
  #top .menu .md {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--muted);
  }

  #top .menu .mi.on .mk,
  #top .menu .mi.on .mn {
    color: var(--accent);
  }

  #top .menu .mi.on .md {
    color: var(--ink);
  }

  #top .menu .none {
    height: 28px;
    padding-left: 40px;
    line-height: 28px;
    color: var(--muted);
  }

  @media (max-width: 1240px) {
    #top .tray {
      margin-left: 0;
      margin-right: 0;
    }
  }

  @media (max-width: 900px) {
    #top {
      padding-top: 64px;
    }

    #top h1 {
      max-width: 640px;
    }

    #top .ico {
      width: 56px;
      height: 56px;
      border-radius: 15px;
    }

    #top .ico svg {
      width: 28px;
      height: 28px;
    }

    #top .hero p {
      margin-top: 24px;
    }

    #top .tray {
      margin-top: 56px;
      padding: 24px 18px;
    }

    #top .lst .r {
      grid-template-columns: 22px 250px minmax(0, 1fr) 40px;
      column-gap: 14px;
    }

    #top .menu .mi {
      grid-template-columns: 22px 250px minmax(0, 1fr);
      column-gap: 14px;
    }
  }

  @media (max-width: 640px) {
    #top {
      padding-top: 40px;
      padding-left: 8px;
      padding-right: 8px;
    }

    #top .hero {
      padding: 0 8px;
    }

    #top h1 {
      line-height: 1.12;
      letter-spacing: -0.035em;
    }

    #top .ico {
      width: 40px;
      height: 40px;
      margin: 0 2px;
      border-radius: 11px;
    }

    #top .ico svg {
      width: 20px;
      height: 20px;
    }

    #top .hero p {
      margin-top: 18px;
    }

    #top .tray {
      margin-top: 36px;
      padding: 12px 8px;
    }

    #top .av {
      padding: 16px 16px 0;
    }

    #top .prompt {
      margin: 0 -16px;
      padding-left: 16px;
      padding-right: 16px;
    }

    #top .cnts {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    #top .lst .r {
      grid-template-columns: 18px minmax(0, 1fr) 34px;
      column-gap: 10px;
    }

    #top .lst .d {
      display: none;
    }

    #top .menu {
      padding-left: 16px;
      padding-right: 16px;
    }

    #top .menu .mi {
      grid-template-columns: 18px minmax(0, 1fr);
      column-gap: 10px;
    }

    #top .menu .md {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #top .lst .s.sp::after {
      content: '✻';
    }
  }
</style>

<script>
  import { holdOn, reducedMotion } from '../../lib/scene'

  interface Session {
    n: string
    aw?: string
    wk: string
    dn: string
  }
  interface Live extends Session {
    age: number
    key: string
  }
  interface Data {
    pool: Session[]
    steps: string[]
    pinned: { name: string; line: string; age: string }
    completed: number
    opening: { awaiting: number[]; working: number[]; done: number[] }
    flow: string[]
    skills: { name: string; line: string }[]
    noMatch: string
    shellHint: string
  }
  type Kind = 'pin' | 'aw' | 'wk' | 'dn'
  interface Row extends HTMLDivElement {
    kind?: Kind
    line?: string
  }

  const source = document.getElementById('av-data')
  const list = document.getElementById('av-list')
  const counts = document.getElementById('av-counts')
  const ask = document.getElementById('av-ask')
  const menu = document.getElementById('av-menu')

  if (
    source &&
    list &&
    counts &&
    ask instanceof HTMLInputElement &&
    menu &&
    source.textContent
  ) {
    const data = JSON.parse(source.textContent) as Data
    const ROW = 30
    const HEAD = 26
    const GAP = 16
    const HEIGHT = 404
    const esc = (text: string) =>
      text.replace(/&/g, '&amp;').replace(/</g, '&lt;')

    let cursor = 0
    let tick = 0
    let done = data.completed
    const state = {
      pin: data.pinned.line,
      aw: [] as Live[],
      wk: [] as Live[],
      dn: [] as Live[],
    }
    const rows = new Map<string, Row>()
    const heads = new Map<string, HTMLDivElement>()

    const inUse = (name: string) =>
      [...state.aw, ...state.wk, ...state.dn].some((s) => s.n === name)
    function take(need?: (s: Session) => boolean): Live | null {
      for (let i = 0; i < data.pool.length; i++) {
        const s = data.pool[cursor % data.pool.length]
        cursor++
        if (!s || inUse(s.n) || (need && !need(s))) continue
        return { ...s, age: 0, key: `${s.n}#${cursor}` }
      }
      return null
    }
    const seed = (
      list: Live[],
      ages: number[],
      need?: (s: Session) => boolean,
    ) =>
      ages.forEach((age) => {
        const s = take(need)
        if (s) list.push({ ...s, age })
      })
    seed(state.aw, data.opening.awaiting, (s) => Boolean(s.aw))
    seed(state.wk, data.opening.working, (s) => !s.aw)
    seed(state.dn, data.opening.done)

    function head(id: string, text: string) {
      let node = heads.get(id)
      if (!node) {
        node = document.createElement('div')
        node.className = 'g'
        node.textContent = text
        list?.appendChild(node)
        heads.set(id, node)
      }
      return node
    }
    const glyph = (kind: Kind) =>
      kind === 'aw'
        ? '<span class="s wt">◆</span>'
        : kind === 'wk'
          ? '<span class="s sp"></span>'
          : kind === 'pin'
            ? '<span class="s">✻</span>'
            : '<span class="s dn">✓</span>'
    const age = (minutes: number) =>
      minutes < 60 ? `${minutes}m` : `${Math.floor(minutes / 60)}h`

    function row(
      key: string,
      kind: Kind,
      name: string,
      line: string,
      minutes: number,
      old = false,
    ): Row {
      const id = `${key}:${kind}`
      const when = kind === 'pin' ? data.pinned.age : age(minutes)
      const html = `<span>${glyph(kind)}</span><span class="n">${esc(name)}</span><span class="d">${esc(line)}</span><span class="t">${when}</span>`
      let node = rows.get(id)
      if (!node) {
        node = document.createElement('div') as Row
        node.className = `r enter arriving${kind === 'pin' ? ' pin' : ''}`
        node.innerHTML = html
        list?.appendChild(node)
        rows.set(id, node)
        const born = node
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            born.classList.remove('enter')
            setTimeout(() => born.classList.remove('arriving'), 1200)
          }),
        )
      } else if (node.kind !== kind || node.line !== line) {
        node.innerHTML = html
        node.classList.remove('flash')
        void node.offsetWidth
        node.classList.add('flash')
      } else {
        const t = node.querySelector('.t')
        if (t) t.textContent = when
      }
      node.kind = kind
      node.line = line
      if (old) {
        const s = node.querySelector('.s')
        if (s) {
          s.className = 's old'
          s.textContent = '·'
        }
      }
      return node
    }

    function layout() {
      let y = 0
      const seen = new Set<string>()
      const place = (node: HTMLElement, id: string) => {
        node.style.top = `${y}px`
        seen.add(id)
        y += ROW
      }
      const showHead = (id: string, text: string, show: boolean) => {
        const node = head(id, text)
        const was = node.style.opacity !== '0'
        if (show) {
          node.style.transition = was
            ? ''
            : 'top 0s, opacity var(--duration-fade) var(--ease-standard) 750ms'
          node.style.top = `${y}px`
          node.style.opacity = '1'
          y += HEAD
        } else {
          node.style.opacity = '0'
        }
      }
      showHead('pin', 'Pinned', true)
      place(row('pin', 'pin', data.pinned.name, state.pin, 0), 'pin:pin')
      y += GAP
      showHead('aw', 'Awaiting input', state.aw.length > 0)
      state.aw.forEach((s) =>
        place(row(s.key, 'aw', s.n, s.aw ?? '', s.age), `${s.key}:aw`),
      )
      if (state.aw.length) y += GAP
      showHead('wk', 'Working', true)
      state.wk.forEach((s) =>
        place(row(s.key, 'wk', s.n, s.wk, s.age), `${s.key}:wk`),
      )
      y += GAP
      showHead('dn', 'Completed', true)
      state.dn.forEach((s, i) => {
        if (y + ROW > HEIGHT) return
        place(row(s.key, 'dn', s.n, s.dn, s.age, i >= 3), `${s.key}:dn`)
      })
      rows.forEach((node, id) => {
        if (seen.has(id)) return
        node.classList.add('leave')
        rows.delete(id)
        setTimeout(() => node.remove(), 400)
      })
      if (counts)
        counts.innerHTML = `<b>${state.aw.length}</b> awaiting input · <b>${state.wk.length}</b> working · <b>${done}</b> completed`
    }

    function step() {
      const kind = data.steps[tick % data.steps.length]
      tick++
      ;[...state.aw, ...state.wk, ...state.dn].forEach((s) => (s.age += 1))
      if (kind === 'complete' && state.wk.length > 1) {
        const s = state.wk.shift()
        if (s) {
          s.age = 0
          state.dn.unshift(s)
          done++
          state.pin = `${s.n.replace(/^[a-z-]+?-canon-/, '')} merged, next row is ready`
        }
      } else if (kind === 'answer' && state.aw.length) {
        const s = state.aw.shift()
        if (s) {
          s.age = 0
          state.wk.push(s)
          state.pin = `Answers in for ${s.n}, it starts the plan`
        }
      } else {
        const s = take(
          state.wk.length >= 4
            ? (x) => Boolean(x.aw) && !state.aw.length
            : undefined,
        )
        if (s) {
          if (s.aw && state.aw.length < 1) {
            state.aw.push(s)
            state.pin = `Dispatched ${s.n}, it has questions`
          } else {
            state.wk.push(s)
            state.pin = `Dispatched ${s.n}`
          }
        }
      }
      if (state.dn.length > 8) state.dn.length = 8
      layout()
    }

    /* Hover follows the pointer while rows move under it. */
    let px: number | null = null
    let py = 0
    let hot: Element | null = null
    let frame = 0
    function track() {
      frame = 0
      let found: Element | null = null
      if (px !== null) {
        found =
          document
            .elementFromPoint(px, py)
            ?.closest('#av-list .r:not(.leave)') ?? null
      }
      if (found !== hot) {
        hot?.classList.remove('hot')
        found?.classList.add('hot')
        hot = found
      }
      if (px !== null) frame = requestAnimationFrame(track)
    }
    list.addEventListener('pointermove', (event) => {
      px = event.clientX
      py = event.clientY
      if (!frame) frame = requestAnimationFrame(track)
    })
    list.addEventListener('pointerleave', () => {
      px = null
      if (frame) cancelAnimationFrame(frame)
      frame = 0
      hot?.classList.remove('hot')
      hot = null
    })

    /* The block cursor sits where typing starts, measured off a run of mono glyphs. */
    const field = ask.parentElement
    const caret = field?.querySelector<HTMLElement>('.c')
    const ruler = field?.querySelector<HTMLElement>('.mz')
    const hint = field?.querySelector<HTMLElement>('.ph')
    const prompt = ask.closest<HTMLElement>('.prompt')
    const mark = prompt?.querySelector<HTMLElement>('.p')
    const baseHint = hint?.textContent ?? ''
    function place() {
      if (!caret || !ruler) return
      const width = ruler.getBoundingClientRect().width / 20
      const at =
        ask instanceof HTMLInputElement
          ? ask.selectionDirection === 'backward'
            ? ask.selectionStart
            : ask.selectionEnd
          : null
      const index =
        at ?? (ask instanceof HTMLInputElement ? ask.value.length : 0)
      const left =
        ask instanceof HTMLInputElement ? index * width - ask.scrollLeft : 0
      caret.style.left = `${Math.max(0, left)}px`
    }
    ;['input', 'click', 'focus', 'select', 'keyup'].forEach((name) =>
      ask.addEventListener(name, () => requestAnimationFrame(place)),
    )
    document.addEventListener('selectionchange', () => {
      if (document.activeElement === ask) place()
    })
    ask.addEventListener('blur', () => {
      if (!ask.value && caret) caret.style.left = '0px'
    })

    /* The `/` menu: the workflow skills first, then the rest of the catalog. */
    const byName = new Map(data.skills.map((s) => [s.name, s]))
    const ordered = [
      ...data.flow.flatMap((name) => {
        const s = byName.get(name)
        return s ? [s] : []
      }),
      ...data.skills.filter((s) => !data.flow.includes(s.name)),
    ]
    let hits = ordered
    let selected = 0
    let shut = false
    let shell = false
    let occlude = 0
    function match() {
      const q =
        ask instanceof HTMLInputElement
          ? ask.value
              .slice(1)
              .toLowerCase()
              .replace(/^canon:/, '')
          : ''
      if (!q) return ordered
      const starts = data.skills.filter((s) => s.name.startsWith(q))
      const holds = data.skills.filter(
        (s) => !s.name.startsWith(q) && s.name.includes(q),
      )
      return [...starts, ...holds]
    }
    function hideUnder() {
      if (!menu || !list) return
      const top = menu.hidden ? Infinity : menu.getBoundingClientRect().top
      list.querySelectorAll('.r, .g').forEach((node) => {
        const reach = node.classList.contains('g') ? 30 : 0
        node.classList.toggle(
          'under',
          node.getBoundingClientRect().bottom + reach > top - 2,
        )
      })
      occlude = menu.hidden ? 0 : requestAnimationFrame(hideUnder)
    }
    function draw() {
      if (!(ask instanceof HTMLInputElement) || !menu) return
      const open =
        !shell &&
        !shut &&
        ask.value.startsWith('/') &&
        !/\s/.test(ask.value) &&
        document.activeElement === ask
      menu.hidden = !open
      ask.setAttribute('aria-expanded', String(open))
      if (open) {
        hits = match()
        if (selected >= hits.length) selected = Math.max(0, hits.length - 1)
        if (!hits.length) {
          menu.innerHTML = `<div class="none">${esc(data.noMatch)}</div>`
          ask.removeAttribute('aria-activedescendant')
        } else {
          menu.innerHTML = hits
            .map(
              (s, i) =>
                `<div class="mi${i === selected ? ' on' : ''}" role="option" id="av-mi-${i}" aria-selected="${i === selected}" data-i="${i}"><span class="mk">❯</span><span class="mn">/canon:${esc(s.name)}</span><span class="md">(canon) ${esc(s.line)}</span></div>`,
            )
            .join('')
          ask.setAttribute('aria-activedescendant', `av-mi-${selected}`)
          const on = menu.children[selected]
          if (on instanceof HTMLElement) {
            const top = on.offsetTop - 4
            const bottom = top + 28
            if (top < menu.scrollTop) menu.scrollTop = top
            else if (bottom > menu.scrollTop + 168)
              menu.scrollTop = bottom - 168
          }
        }
      } else {
        ask.removeAttribute('aria-activedescendant')
      }
      if (!menu.hidden && !occlude) occlude = requestAnimationFrame(hideUnder)
      if (menu.hidden && occlude) {
        cancelAnimationFrame(occlude)
        occlude = 0
        hideUnder()
      }
    }
    function accept(index: number) {
      const s = hits[index]
      if (!s || !(ask instanceof HTMLInputElement)) return
      ask.value = `/canon:${s.name} `
      shut = true
      draw()
      ask.setSelectionRange(ask.value.length, ask.value.length)
      requestAnimationFrame(place)
    }
    function mode(on: boolean) {
      shell = on
      prompt?.classList.toggle('shell', on)
      if (mark) mark.textContent = on ? '!' : '❯'
      if (hint) hint.textContent = on ? data.shellHint : baseHint
      draw()
    }
    menu.addEventListener('pointerdown', (event) => {
      const item =
        event.target instanceof Element
          ? event.target.closest<HTMLElement>('.mi')
          : null
      if (!item) return
      event.preventDefault()
      accept(Number(item.dataset.i))
      ask.focus()
    })
    menu.addEventListener('pointermove', (event) => {
      const item =
        event.target instanceof Element
          ? event.target.closest<HTMLElement>('.mi')
          : null
      if (item && Number(item.dataset.i) !== selected) {
        selected = Number(item.dataset.i)
        draw()
      }
    })
    ask.addEventListener('keydown', (event) => {
      const open = !menu.hidden && hits.length > 0
      if (open && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
        event.preventDefault()
        selected =
          (selected + (event.key === 'ArrowDown' ? 1 : -1) + hits.length) %
          hits.length
        draw()
        return
      }
      if (open && (event.key === 'Tab' || event.key === 'Enter')) {
        event.preventDefault()
        accept(selected)
        return
      }
      if (event.key === 'Escape' && !menu.hidden) {
        event.preventDefault()
        shut = true
        draw()
        return
      }
      if (
        (event.key === 'Escape' || event.key === 'Backspace') &&
        shell &&
        !ask.value
      ) {
        event.preventDefault()
        mode(false)
        return
      }
      if (event.key === 'Enter') {
        event.preventDefault()
        ask.value = ''
        shut = false
        selected = 0
        if (shell) mode(false)
        else draw()
      }
      requestAnimationFrame(place)
    })
    ask.addEventListener('input', () => {
      shut = false
      selected = 0
      if (!shell && ask.value.startsWith('!')) {
        ask.value = ask.value.slice(1)
        mode(true)
        ask.setSelectionRange(ask.value.length, ask.value.length)
      }
      draw()
    })
    ask.addEventListener('focus', draw)
    ask.addEventListener('blur', () => {
      menu.hidden = true
      ask.setAttribute('aria-expanded', 'false')
      if (occlude) cancelAnimationFrame(occlude)
      occlude = 0
      hideUnder()
    })

    layout()

    /*
     * The loop halts while the reader holds the view, by pointer or focus,
     * so moving content stops under the person reading it.
     */
    const held = holdOn(list.closest('.av'))
    if (!reducedMotion())
      setInterval(() => {
        if (!held()) step()
      }, 2600)
  }
</script>
