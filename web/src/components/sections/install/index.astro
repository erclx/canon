---
import { install } from '../../../content/copy'
import './style.css'

/**
 * The heading and lead-in beside the three commands in a drawn card, with one
 * copy control and the first run under them. The control stacks both of its
 * labels in one cell, so the shorter one never shrinks it and the card holds
 * its height through a press.
 */
---

<section class="part" id="install">
  <div class="w split">
    <div class="say">
      <h2>{install.head}</h2>
      <p class="lede">{install.lede}</p>
    </div>
    <div class="cmd ink" data-commands={install.commands.join('\n')}>
      <div class="cbody">
        {
          install.commands.map((command) => (
            <code>
              <span class="pr" aria-hidden="true">
                ${' '}
              </span>
              {command}
            </code>
          ))
        }
      </div>
      <div class="cfoot">
        <button
          type="button"
          class="drawn copy"
          data-label={install.copy.label}
          data-done={install.copy.done}
          data-status={install.copy.status}
        >
          <span class="now">{install.copy.label}</span>
          <span class="hold" aria-hidden="true">{install.copy.label}</span>
          <span class="hold" aria-hidden="true">{install.copy.done}</span>
        </button>
        <span class="note">{install.first}</span>
        <span class="sr-only" role="status" aria-live="polite"></span>
      </div>
    </div>
  </div>
</section>

<script src="./client.ts"></script>
