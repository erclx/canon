---
import { readFileSync } from 'node:fs'
import { join } from 'node:path'

import { film } from '../../../content/copy'
import { repoRoot } from '../../../lib/canon-cli'
import PauseButton from '../../pause-button/index.astro'
import './style.css'

/**
 * A pull request's evidence comment playing a real reel of this page's
 * records section, which `scripts/core/regen-web-film.ts` films as
 * `web/film-plan.json` names the beats. The beat row and the bar under the
 * reel keep its time from the stamp's seconds, and each checklist line ticks
 * as its beat ends. Pausing swaps the reel for its closing still, and reduced
 * motion shows that still with every line ticked.
 */

interface Props {
  /** The shape `pages/index.astro` gives the section, read by `styles/global.css`. */
  class?: string
}

const { class: shape } = Astro.props
const root = repoRoot()
const plan = JSON.parse(
  readFileSync(join(root, 'web/film-plan.json'), 'utf8'),
) as { beats: { name: string }[] }
const stamp = Object.fromEntries(
  readFileSync(join(root, 'assets/loops/film.stamp'), 'utf8')
    .split('\n')
    .filter(Boolean)
    .map((line) => line.split(': ') as [string, string]),
)
const beats = (stamp.beats ?? '').split(' ').map(Number)
const total = Number(stamp['reel-seconds'])
if (beats.length !== plan.beats.length || !(total > 0))
  throw new Error(
    'assets/loops/film.stamp does not match web/film-plan.json, so run bun run web:film -- --write',
  )
if (film.view.checks.length !== plan.beats.length)
  throw new Error(
    'film.view.checks in copy.ts needs one line per beat in web/film-plan.json',
  )
const clock = (seconds: number) =>
  `0:${String(Math.round(seconds)).padStart(2, '0')}`
const reels = [
  { theme: 'dk', reel: '/film.webp', still: '/film-still.webp' },
  { theme: 'lt', reel: '/film-light.webp', still: '/film-still-light.webp' },
]
---

<section class:list={['sec', shape]} id="film">
  <div class="sec-head">
    <h2>{film.head}</h2>
    <p>{film.lede}</p>
  </div>
  <div class="tray">
    <PauseButton />
    <div class="win fm">
      <div class="fh">
        <b>{film.view.title}</b>
        <span>· {film.view.source}</span>
      </div>
      <div class="stage">
        {
          reels.map((item) => (
            <picture class={item.theme}>
              <source
                media="(prefers-reduced-motion: reduce)"
                srcset={item.still}
              />
              <img
                src={item.reel}
                data-reel={item.reel}
                data-still={item.still}
                alt={film.view.alt}
                width="960"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </picture>
          ))
        }
      </div>
      <div class="ctl" aria-hidden="true">
        <span class="tri"></span>
        <span class="bar"><i></i></span>
        <span class="t"
          ><span class="now">{clock(total)}</span> / {clock(total)}</span
        >
      </div>
      <ol class="beats" role="list">
        {
          plan.beats.map((beat, index) => (
            <li class:list={{ on: index === plan.beats.length - 1 }}>
              {beat.name}
            </li>
          ))
        }
      </ol>
      <ul class="checks" role="list">
        {
          film.view.checks.map((check) => (
            <li class="done">
              <span class="ck" aria-hidden="true" />
              <span class="tx">{check}</span>
              <span class="who">{film.view.who}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <script
    type="application/json"
    class="film-data"
    set:html={JSON.stringify({ beats, total })}
  />
</section>

<script src="./client.ts"></script>
