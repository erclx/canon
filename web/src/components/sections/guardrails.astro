---
import { guardrailScenes, guardrails } from '../../content/copy'

/**
 * The refusal first: a Claude Code window on the tray above the four parts.
 * It plays one scene per part once, when it scrolls into view, and rests on
 * the plan guard's refusal. A click on a part plays that scene and rests
 * there. The window holds the height of its tallest scene, so a scene never
 * moves the page.
 */
const REST = 1
---

<section class="sec" id="guardrails">
  <div class="sec-head">
    <h2>{guardrails.head}</h2>
    <p>{guardrails.lede}</p>
  </div>
  <div class="tray">
    <div class="win" aria-hidden="true">
      <div class="win-bar"><i></i><i></i><i></i><span>claude</span></div>
      <div class="log"></div>
    </div>
  </div>
  <div class="four">
    {
      guardrails.parts.map((part, index) => (
        <div class={`lit-row${index === REST ? ' lit' : ''}`} data-i={index}>
          <button type="button" class="go" aria-label={part.play}>
            {part.name}
          </button>
          <p>{part.line}</p>
          <code>{part.real}</code>
        </div>
      ))
    }
  </div>
  <p class="sr-only" role="status"></p>
  <script
    type="application/json"
    class="guardrails-data"
    set:html={JSON.stringify({ scenes: guardrailScenes, rest: REST })}
  />
</section>

<style is:global>
  #guardrails .tray {
    margin-top: 52px;
  }

  #guardrails .log {
    padding: 18px 26px 22px;
    transition: opacity var(--duration-fade) var(--ease-standard);
  }

  #guardrails .log.hide {
    opacity: 0;
  }

  #guardrails .log .ask {
    margin: 0 -26px 14px;
    padding: 8px 26px;
  }

  #guardrails .log .tool,
  #guardrails .log .say {
    position: relative;
    padding-left: 22px;
    color: var(--ink);
  }

  #guardrails .log .tool::before,
  #guardrails .log .say::before {
    content: '\25CF';
    position: absolute;
    left: 0;
    top: 0;
    font-size: var(--size-view-small);
    color: var(--accent);
    user-select: none;
  }

  #guardrails .log .say {
    margin-top: 6px;
  }

  #guardrails .log .say::before {
    color: var(--ink);
  }

  #guardrails .log .tool b {
    font-weight: 500;
  }

  #guardrails .log :is(.tool, .res, .note, .block) + .tool {
    margin-top: 6px;
  }

  #guardrails .log :is(.res, .note, .block) {
    display: flex;
    gap: 10px;
    padding-left: 24px;
  }

  #guardrails .log :is(.res, .note, .block)::before {
    content: '\23BF';
    flex: none;
    color: var(--muted);
    user-select: none;
  }

  #guardrails .log .note {
    color: var(--muted);
  }

  #guardrails .log .why {
    color: var(--accent);
  }

  #guardrails .log .msg {
    display: block;
    margin-top: 2px;
    color: var(--body);
    text-wrap: pretty;
  }

  #guardrails .four {
    --lit-inset: -14px -16px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px;
    margin-top: 48px;
  }

  #guardrails .four > div {
    display: flex;
    flex-direction: column;
  }

  #guardrails .four .go {
    font-family: var(--sans);
    font-size: var(--size-body);
    font-weight: 600;
    color: var(--ink);
  }

  #guardrails .four p {
    margin: 8px 0 0;
    font-size: var(--size-body);
    line-height: var(--type-body-lh);
    text-wrap: pretty;
  }

  #guardrails .four code {
    display: block;
    margin-top: auto;
    padding-top: 12px;
    font-size: var(--size-small);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    #guardrails .tray {
      margin-top: 40px;
    }

    #guardrails .four {
      grid-template-columns: 1fr 1fr;
      gap: 32px 36px;
    }
  }

  @media (max-width: 640px) {
    #guardrails .tray {
      margin-top: 32px;
    }

    #guardrails .log {
      padding: 14px 16px 18px;
    }

    #guardrails .log .ask {
      margin: 0 -16px 12px;
      padding: 7px 16px;
    }

    #guardrails .four {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }
</style>

<script>
  import { escapeHtml, pacer, reducedMotion } from '../../lib/scene'

  type Line = [string, string, string]
  interface Scene {
    ask: string
    lines: Line[]
  }

  const section = document.getElementById('guardrails')
  const source = section?.querySelector('.guardrails-data')
  const log = section?.querySelector<HTMLElement>('.log')

  if (section && source?.textContent && log) {
    const { scenes, rest } = JSON.parse(source.textContent) as {
      scenes: Scene[]
      rest: number
    }
    const parts = [...section.querySelectorAll<HTMLElement>('.four > div')]
    const status = section.querySelector<HTMLElement>('[role="status"]')
    const pace = pacer()
    const still = reducedMotion()
    let current = rest

    function mark(index: number) {
      parts.forEach((part, j) => part.classList.toggle('lit', j === index))
    }

    function line([kind, lead, text]: Line) {
      const node = document.createElement('div')
      node.className = kind
      if (kind === 'tool')
        node.innerHTML = `<b>${lead}</b>(${escapeHtml(text)})`
      else if (kind === 'block')
        node.innerHTML = `<span><span class="why">${escapeHtml(lead)}</span><span class="msg">${escapeHtml(text)}</span></span>`
      else node.textContent = text
      return node
    }
    function askLine(text: string) {
      const node = document.createElement('div')
      node.className = 'ask'
      node.innerHTML = `<span class="g">❯</span><span>${escapeHtml(text)}</span>`
      return node
    }

    function full(index: number) {
      const scene = scenes[index]
      if (!scene) return
      log!.replaceChildren(askLine(scene.ask), ...scene.lines.map(line))
    }

    /** The window keeps the height of its tallest scene. */
    function size() {
      log!.style.height = ''
      let tallest = 0
      scenes.forEach((_, i) => {
        full(i)
        tallest = Math.max(tallest, log!.scrollHeight)
      })
      log!.style.height = `${tallest}px`
      full(current)
    }

    function announce(index: number) {
      const block = scenes[index]?.lines.find(([kind]) => kind === 'block')
      if (status) status.textContent = block ? `${block[1]}. ${block[2]}` : ''
    }

    async function play(index: number, generation: number) {
      const scene = scenes[index]
      if (!scene) return false
      current = index
      mark(index)
      log!.classList.add('hide')
      if (!(await pace.wait(300, generation))) return false
      log!.replaceChildren(askLine(scene.ask))
      log!.classList.remove('hide')
      for (const item of scene.lines) {
        const gap = item[0] === 'tool' || item[0] === 'say' ? 700 : 300
        if (!(await pace.wait(gap, generation))) return false
        log!.append(line(item))
      }
      return true
    }

    async function tour(generation: number) {
      for (let i = 0; i < scenes.length; i++) {
        if (!(await play(i, generation))) return
        if (!(await pace.wait(1800, generation))) return
      }
      current = rest
      mark(rest)
      log!.classList.add('hide')
      if (!(await pace.wait(300, generation))) return
      full(rest)
      log!.classList.remove('hide')
    }

    parts.forEach((part, index) =>
      part.querySelector('.go')?.addEventListener('click', () => {
        const generation = pace.next()
        announce(index)
        if (still) {
          current = index
          mark(index)
          full(index)
        } else void play(index, generation)
      }),
    )

    size()
    mark(rest)
    window.addEventListener('resize', size)
    void document.fonts?.ready.then(size)

    if (!still) {
      const tray = section.querySelector('.tray')
      const observer = new IntersectionObserver(
        (entries) => {
          if (
            entries.some((e) => e.isIntersecting && e.intersectionRatio >= 0.4)
          ) {
            observer.disconnect()
            void tour(pace.next())
          }
        },
        { threshold: [0.4] },
      )
      if (tray) observer.observe(tray)
    }
  }
</script>
