---
import { roleScenes, roles } from '../../content/copy'

/**
 * A Claude Code window beside the five roles. The window loops through each
 * role's scene, typing its request, then showing what it did and said, and a
 * pick plays that role's scene and carries the loop on from it. Above 900 the
 * roles are a list with lines, below it a row of pickers over the window.
 */
---

<section class="sec" id="roles">
  <div class="sec-head">
    <h2>{roles.head}</h2>
    <p>{roles.lede}</p>
  </div>
  <div class="tray">
    <div class="two">
      <div class="win">
        <div class="win-bar"><i></i><i></i><i></i><span>claude</span></div>
        <div class="log" aria-live="polite"></div>
        <div class="inp">
          <div class="rule">
            <i></i><span class="who"></span><i class="s"></i>
          </div>
          <div class="line">
            <span class="g">❯</span><span
              ><span class="typed"></span><span class="cur"></span></span
            >
          </div>
          <div class="bot"></div>
        </div>
      </div>
      <div class="list" role="group" aria-label="Roles">
        {
          roleScenes.map((role, index) => (
            <button
              type="button"
              aria-pressed={index === 0 ? 'true' : 'false'}
              data-i={index}
            >
              <b>{role.name}</b>
              <span>{role.line}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
  <script
    type="application/json"
    class="roles-data"
    set:html={JSON.stringify(roleScenes)}
  />
</section>

<style is:global>
  #roles .tray {
    margin-top: 56px;
  }

  #roles .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 36px;
    align-items: center;
  }

  #roles .win {
    height: 452px;
  }

  #roles .log {
    flex: 1;
    min-height: 0;
    padding: 20px 26px 0;
    overflow: hidden;
  }

  #roles .log > div {
    transition: opacity var(--duration-fade) var(--ease-standard);
  }

  #roles .log .hide {
    opacity: 0;
  }

  #roles .log .ask {
    margin: 0 -26px 16px;
    padding: 8px 26px;
  }

  #roles .log .act {
    margin-bottom: 14px;
    color: var(--muted);
  }

  #roles .log .act span {
    display: flex;
    gap: 10px;
    padding-left: 4px;
  }

  #roles .log .act span::before {
    content: '\23BF';
    flex: none;
  }

  #roles .log .say {
    position: relative;
    margin-bottom: 8px;
    padding-left: 22px;
    color: var(--ink);
  }

  #roles .log .say.first::before {
    content: '\25CF';
    position: absolute;
    left: 0;
    top: 0;
    font-size: var(--size-view-small);
    color: var(--ink);
  }

  #roles .inp {
    flex: none;
    padding: 0 26px 16px;
  }

  #roles .inp .rule {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--size-view-small);
    color: var(--muted);
  }

  #roles .inp .rule i {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  #roles .inp .rule i.s {
    flex: 0 0 18px;
  }

  #roles .inp .line {
    display: flex;
    gap: 10px;
    padding: 10px 0;
    white-space: pre-wrap;
    color: var(--ink);
  }

  #roles .inp .line .g {
    flex: none;
    color: var(--muted);
  }

  #roles .inp .bot {
    height: 1px;
    background: var(--line);
  }

  #roles .list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #roles .list button {
    all: unset;
    box-sizing: border-box;
    display: block;
    width: 100%;
    padding: 12px 14px 14px;
    border-radius: var(--radius-panel);
    font-family: var(--sans);
    cursor: pointer;
  }

  #roles .list button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  #roles .list button[aria-pressed='true'] {
    background: var(--win);
    box-shadow: var(--shadow-ring);
  }

  #roles .list b {
    display: block;
    font-size: var(--size-body);
    font-weight: 600;
    color: var(--ink);
  }

  #roles .list span {
    display: block;
    margin-top: 2px;
    font-size: var(--size-small);
    color: var(--muted);
  }

  @media (hover: hover) {
    #roles .list button:hover {
      background: var(--hover);
    }

    #roles .list button[aria-pressed='true']:hover {
      background: var(--win);
    }
  }

  @media (max-width: 900px) {
    #roles .tray {
      margin-top: 40px;
    }

    #roles .two {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    #roles .list {
      order: -1;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    /* Below 900 the roles are one-line pickers, the page's one picker shape. */
    #roles .list button {
      width: auto;
      padding: 5px 14px;
      border-radius: var(--radius-action);
      box-shadow: inset 0 0 0 1px var(--line);
      line-height: 18px;
    }

    #roles .list button[aria-pressed='true'] {
      background: var(--ink);
      box-shadow: none;
    }

    #roles .list b {
      font-size: var(--size-small);
      font-weight: 500;
      color: var(--body);
    }

    #roles .list button[aria-pressed='true'] b {
      color: var(--ground);
    }

    #roles .list span {
      display: none;
    }

    @media (hover: hover) {
      #roles .list button:hover {
        background: var(--win);
      }

      #roles .list button[aria-pressed='true']:hover {
        background: var(--ink);
      }
    }
  }

  @media (max-width: 640px) {
    #roles .tray {
      margin-top: 32px;
    }

    #roles .list {
      gap: 6px;
    }

    #roles .list button {
      padding: 5px 12px;
    }

    #roles .win {
      height: 500px;
    }

    #roles .log {
      padding: 16px 16px 0;
    }

    #roles .log .ask {
      margin: 0 -16px 14px;
      padding: 8px 16px;
    }

    #roles .inp {
      padding: 0 16px 14px;
    }

    #roles .inp .rule span {
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }
</style>

<script>
  import { escapeHtml, holdOn, pacer, reducedMotion } from '../../lib/scene'

  interface Scene {
    session: string
    prompt: string
    act: string[]
    say: string[]
  }

  const section = document.getElementById('roles')
  const source = section?.querySelector('.roles-data')
  const log = section?.querySelector<HTMLElement>('.log')
  const typed = section?.querySelector<HTMLElement>('.typed')
  const who = section?.querySelector<HTMLElement>('.who')
  const buttons = [
    ...(section?.querySelectorAll<HTMLButtonElement>('.list button') ?? []),
  ]

  if (section && source?.textContent && log && typed && who) {
    const scenes = JSON.parse(source.textContent) as Scene[]
    const pace = pacer(holdOn(section.querySelector('.win')))
    const still = reducedMotion()

    const block = (className: string, html: string) => {
      const node = document.createElement('div')
      node.className = className
      node.innerHTML = html
      return node
    }
    const ask = (scene: Scene) =>
      block(
        'ask',
        `<span class="g">❯</span><span>${escapeHtml(scene.prompt)}</span>`,
      )
    const act = (scene: Scene) =>
      block(
        'act',
        escapeHtml(scene.act[0] ?? '') +
          scene.act
            .slice(1)
            .map((line) => `<span>${escapeHtml(line)}</span>`)
            .join(''),
      )
    const say = (line: string, first: boolean) =>
      block(`say${first ? ' first' : ''}`, escapeHtml(line))

    function mark(index: number) {
      buttons.forEach((button, j) =>
        button.setAttribute('aria-pressed', String(j === index)),
      )
      who!.textContent = scenes[index]?.session ?? ''
    }

    function full(index: number) {
      const scene = scenes[index]
      if (!scene) return
      mark(index)
      typed!.textContent = ''
      log!.replaceChildren(
        ask(scene),
        act(scene),
        ...scene.say.map((line, k) => say(line, k === 0)),
      )
    }

    async function show(node: HTMLElement, generation: number) {
      node.classList.add('hide')
      log!.append(node)
      if (!(await pace.wait(30, generation))) return false
      node.classList.remove('hide')
      return true
    }

    async function play(index: number, generation: number) {
      const scene = scenes[index]
      if (!scene) return false
      mark(index)
      ;[...log!.children].forEach((child) => child.classList.add('hide'))
      if (!(await pace.wait(300, generation))) return false
      log!.replaceChildren()
      typed!.textContent = ''
      if (!(await pace.wait(250, generation))) return false
      for (const char of scene.prompt) {
        typed!.textContent += char
        if (!(await pace.wait(11, generation))) return false
      }
      const pause = Math.min(2200, 700 + scene.prompt.length * 10)
      if (!(await pace.wait(pause, generation))) return false
      typed!.textContent = ''
      if (!(await show(ask(scene), generation))) return false
      if (!(await pace.wait(400, generation))) return false
      if (!(await show(act(scene), generation))) return false
      if (!(await pace.wait(500, generation))) return false
      for (const [k, line] of scene.say.entries()) {
        if (!(await show(say(line, k === 0), generation))) return false
        if (!(await pace.wait(320, generation))) return false
      }
      return pace.wait(2600, generation)
    }

    async function loop(from: number) {
      const generation = pace.next()
      let index = from
      while (await play(index, generation)) index = (index + 1) % scenes.length
    }

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const index = Number(button.dataset.i)
        if (still) {
          pace.next()
          full(index)
        } else void loop(index)
      }),
    )

    if (still) full(0)
    else void loop(0)
  }
</script>
