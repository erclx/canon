---
import { nav } from '../content/copy'
import { isPublished, readSession } from '../lib/session'

/**
 * A sticky flat bar carrying the mark, the published version, one link per
 * named beat of the session, the theme toggle and the install action. A
 * floating pill was drafted and rejected: it floats over a centred headline
 * and reads wrong there. The bar takes the ground as its own surface, since
 * the bands alternate tints and a sticky bar crosses a boundary at every one.
 *
 * The version dot is state rather than decoration: it lights only when the
 * registry's latest matches the version this build carries, and an
 * unreachable registry reads as unconfirmed rather than as a match.
 *
 * The mark is inlined rather than linked so it inherits `currentColor`, which
 * is the whole reason `assets/brand/mark.svg` keeps that fill.
 */
const { version } = readSession()
const published = await isPublished(version)
---

<header class="nav">
  <div class="bar">
    <a href="#top" class="logo">
      <svg
        viewBox="15 15 70 70"
        width="15"
        height="15"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M34,20 L15,28 L15,72 L34,80 Z M66,20 L85,28 L85,72 L66,80 Z"
          fill="currentColor"></path>
        <rect x="44" y="15" width="12" height="70" rx="2" fill="currentColor"
        ></rect>
      </svg>
      <span>{nav.mark}</span>
    </a>
    <a
      class="version"
      href={nav.npm}
      title={published ? nav.version.live : nav.version.unconfirmed}
      data-published={String(published)}
    >
      <i class="dot" aria-hidden="true"></i>v{version}
    </a>
    <nav aria-label="Sections">
      {
        nav.links.map((link) => (
          <a href={`#${link.id}`} data-spy={link.id}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class="theme-toggle"
      aria-label={nav.toggleLabel}
      aria-pressed="false"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
    </button>
    <a class="btn btn-primary" href={nav.install.href}>{nav.install.label}</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--ground);
    box-shadow: 0 1px 0 var(--ring);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    max-width: var(--bin);
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--t4);
    color: var(--ink);
    text-decoration: none;
  }

  .logo svg {
    color: var(--mark);
  }

  .version {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--t6);
    color: var(--ink-soft);
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ink-faint);
  }

  .version[data-published='true'] .dot {
    background: var(--ok);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--ok) 18%, transparent);
  }

  nav {
    display: flex;
    gap: var(--space-xs);
    margin: 0 auto;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 var(--space-md);
    border-radius: var(--radius-pill);
    font-size: var(--t4);
    color: var(--ink-soft);
    text-decoration: none;
  }

  nav a[aria-current='true'] {
    color: var(--ink);
    background: var(--tint);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
    background: transparent;
    color: var(--ink-soft);
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
  }

  :global([data-theme='dark']) .theme-toggle circle {
    fill: currentColor;
  }

  nav a,
  .theme-toggle,
  .version {
    transition:
      color 0.16s var(--ease),
      background-color 0.16s var(--ease);
  }

  nav a:hover,
  .theme-toggle:hover,
  .version:hover {
    color: var(--ink);
    background: var(--tint);
  }

  /*
   * The links go below 900. The nav's own auto margins held the two ends of
   * the bar apart, so the first control takes the auto margin instead.
   */
  @media (max-width: 900px) {
    nav {
      display: none;
    }

    .theme-toggle {
      margin-left: auto;
    }
  }

  /*
   * The bar runs out of room before anything else does. The version goes
   * first, since the footer states it again, and the action drops the minimum
   * width that reserved a wider box than its own label needs.
   */
  @media (max-width: 430px) {
    .bar {
      gap: var(--space-md);
    }

    .version {
      display: none;
    }

    .btn {
      min-width: 0;
      padding: 0 var(--space-md);
    }
  }
</style>

<script>
  const root = document.documentElement
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')

  function apply(theme: 'light' | 'dark') {
    root.setAttribute('data-theme', theme)
    toggle?.setAttribute('aria-pressed', String(theme === 'light'))
    try {
      localStorage.setItem('canon-theme', theme)
    } catch {
      // A browser refusing storage still gets the theme for this page view.
    }
  }

  toggle?.setAttribute(
    'aria-pressed',
    String(root.getAttribute('data-theme') === 'light'),
  )
  toggle?.addEventListener('click', () => {
    apply(root.getAttribute('data-theme') === 'light' ? 'dark' : 'light')
  })

  /**
   * The bar publishes the height it rendered, which `scroll-padding-top`
   * derives an anchor's landing from, and re-measures when it wraps.
   */
  const bar = document.querySelector<HTMLElement>('.nav')
  if (bar) {
    const publish = () => {
      root.style.setProperty(
        '--nav-height',
        `${Math.round(bar.getBoundingClientRect().height)}px`,
      )
    }
    publish()
    new ResizeObserver(publish).observe(bar)
  }

  /**
   * Which beat the reader is on. A beat counts once its top crosses a line just
   * under the bar, and the band below 40% of the viewport is ignored, so the
   * link that lights is the beat being read rather than the one arriving.
   */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')]
  const byId = new Map(links.map((link) => [link.dataset.spy ?? '', link]))
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        const current = byId.get(entry.target.id)
        if (!current) continue
        for (const link of links) link.removeAttribute('aria-current')
        current.setAttribute('aria-current', 'true')
      }
    },
    { rootMargin: '-64px 0px -60% 0px' },
  )
  for (const id of byId.keys()) {
    const target = document.getElementById(id)
    if (target) spy.observe(target)
  }
</script>
