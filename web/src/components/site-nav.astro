---
import mark from '../../../assets/brand/mark.svg?raw'
import { nav } from '../content/copy'

/**
 * A sticky flat bar carrying the mark, one in-page link and two outward ones,
 * the theme toggle, and the install action filled in bright ink. The bar takes
 * the ground as its own surface, since the review band crosses under it.
 *
 * The mark is inlined from its source rather than linked, so the c inherits
 * the bar's ink through `currentColor`, which is the whole reason
 * `assets/brand/mark.svg` keeps that fill. The pip takes `--pip`, the mark's
 * own pair, rather than any action color.
 */
const glyph = mark.replace(/<!--[\s\S]*?-->/, '').trim()
---

<header class="nav">
  <div class="bar">
    <a href="#top" class="logo">
      <span class="glyph" aria-hidden="true" set:html={glyph} />
      <span>{nav.mark}</span>
    </a>
    <nav aria-label="Site">
      {nav.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <button
      type="button"
      class="theme-toggle"
      aria-label={nav.toggleLabel}
      aria-pressed="false"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
    </button>
    <a class="btn btn-primary btn-small" href={nav.install.href}
      >{nav.install.label}</a
    >
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--ground);
    box-shadow: 0 1px 0 var(--ring);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    max-width: var(--bin);
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--t4);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }

  .glyph {
    display: flex;
  }

  .glyph :global(svg) {
    width: 22px;
    height: 22px;
  }

  .glyph :global(.pip) {
    fill: var(--pip);
  }

  nav {
    display: flex;
    gap: var(--space-xs);
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 var(--space-md);
    border-radius: var(--radius-action);
    font-size: var(--t4);
    color: var(--ink-body);
    text-decoration: none;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
    background: transparent;
    color: var(--ink-soft);
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
  }

  :global([data-theme='dark']) .theme-toggle circle {
    fill: currentColor;
  }

  nav a,
  .theme-toggle {
    transition:
      color 0.16s var(--ease),
      background-color 0.16s var(--ease);
  }

  nav a:hover,
  .theme-toggle:hover {
    color: var(--ink);
    background: var(--tint);
  }

  /* The links go below 640, and the mark keeps the auto margin that holds the two ends apart. */
  @media (max-width: 640px) {
    nav {
      display: none;
    }

    .bar {
      gap: var(--space-md);
    }
  }
</style>

<script>
  const root = document.documentElement
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')

  function apply(theme: 'light' | 'dark') {
    root.setAttribute('data-theme', theme)
    toggle?.setAttribute('aria-pressed', String(theme === 'light'))
    try {
      localStorage.setItem('canon-theme', theme)
    } catch {
      // A browser refusing storage still gets the theme for this page view.
    }
  }

  toggle?.setAttribute(
    'aria-pressed',
    String(root.getAttribute('data-theme') === 'light'),
  )
  toggle?.addEventListener('click', () => {
    apply(root.getAttribute('data-theme') === 'light' ? 'dark' : 'light')
  })

  /**
   * The bar publishes the height it rendered, which `scroll-padding-top`
   * derives an anchor's landing from, and re-measures when it wraps.
   */
  const bar = document.querySelector<HTMLElement>('.nav')
  if (bar) {
    const publish = () => {
      root.style.setProperty(
        '--nav-height',
        `${Math.round(bar.getBoundingClientRect().height)}px`,
      )
    }
    publish()
    new ResizeObserver(publish).observe(bar)
  }
</script>
