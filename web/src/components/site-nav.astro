---
import mark from '../../../assets/brand/mark.svg?raw'
import { nav, sections } from '../content/copy'

/**
 * The fixed bar: the mark back to the top, the six section jumps, Try it, then
 * Docs and GitHub after a thin rule, and the theme toggle. Below 1040 the
 * jumps fold into a Sections menu, and on a phone Docs and GitHub join it as
 * Menu, so the bar reads Menu, Try it, and the toggle, and focus order matches
 * what shows.
 *
 * The section in view takes ink and the accent underline. The mark is inlined
 * from its source so the c inherits the bar's ink through `currentColor`, and
 * its pip takes `--pip`, the mark's own pair.
 */
const glyph = mark.replace(/<!--[\s\S]*?-->/, '').trim()
---

<header class="site-nav">
  <nav aria-label="Site">
    <a class="brand" href="#top" aria-label={nav.back}>
      <span class="glyph" aria-hidden="true" set:html={glyph} />
      <span>{nav.mark}</span>
    </a>
    <span class="links">
      {
        sections.map((section) => (
          <a class="sl" href={`#${section.id}`} data-section={section.id}>
            {section.label}
          </a>
        ))
      }
      <span class="nmw">
        <button
          type="button"
          class="nbtn"
          aria-expanded="false"
          aria-controls="nav-panel"
        >
          <span class="lw">{nav.menu.wide}</span>
          <span class="lp">{nav.menu.phone}</span>
          <svg
            class="chev"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <span class="npanel" id="nav-panel">
          {
            sections.map((section) => (
              <a href={`#${section.id}`} data-section={section.id}>
                {section.label}
              </a>
            ))
          }
          <span class="ndiv" aria-hidden="true"></span>
          <a class="pext" href={nav.docs.href}>{nav.docs.label}</a>
          <a class="pext" href={nav.github.href}>{nav.github.label}</a>
        </span>
      </span>
      <a class="try" href={nav.try.href}>{nav.try.label}</a>
      <i class="sep" aria-hidden="true"></i>
      <a class="ext" href={nav.docs.href}>{nav.docs.label}</a>
      <a class="ext" href={nav.github.href}>{nav.github.label}</a>
      <button
        type="button"
        class="theme-toggle"
        aria-label={nav.toggle.toDark}
        data-to-dark={nav.toggle.toDark}
        data-to-light={nav.toggle.toLight}
      >
        <svg
          class="moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg
        >
        <svg
          class="sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
          ></path></svg
        >
      </button>
    </span>
  </nav>
</header>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    background: var(--ground);
  }

  nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1240px;
    height: var(--nav-h);
    margin: 0 auto;
    padding: 0 var(--gutter);
    font-size: var(--size-body);
  }

  a {
    color: var(--body);
    text-decoration: none;
    border-radius: var(--radius-action);
  }

  a:hover {
    color: var(--ink);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-weight: 600;
  }

  .glyph {
    display: flex;
  }

  .glyph :global(svg) {
    width: 26px;
    height: 26px;
  }

  .glyph :global(.pip) {
    fill: var(--pip);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .links > a {
    position: relative;
    padding: 6px 0;
  }

  .links > a[aria-current='true'] {
    color: var(--ink);
  }

  .links > a[aria-current='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: var(--radius-marker);
    background: var(--accent);
  }

  .sep {
    align-self: center;
    width: 1px;
    height: 16px;
    background: var(--line);
  }

  .theme-toggle {
    all: unset;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-left: -6px;
    border-radius: var(--radius-action);
    color: var(--body);
    cursor: pointer;
  }

  .theme-toggle svg {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
  }

  .theme-toggle .sun,
  :global([data-theme='dark']) .theme-toggle .moon {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle .sun {
    display: block;
  }

  .theme-toggle:focus-visible,
  .nbtn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .nmw {
    position: relative;
    display: none;
  }

  .nbtn {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    margin: 0 -10px;
    padding: 0 10px;
    border-radius: var(--radius-action);
    font-family: var(--sans);
    font-size: inherit;
    color: var(--ink);
    cursor: pointer;
  }

  .chev {
    width: 15px;
    height: 15px;
    color: var(--muted);
    transition: transform var(--duration-feedback) var(--ease-standard);
  }

  .nbtn[aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }

  .nbtn .lp {
    display: none;
  }

  @media (hover: hover) {
    .theme-toggle:hover,
    .nbtn:hover {
      background: var(--line);
      color: var(--ink);
    }
  }

  .npanel {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: -10px;
    z-index: 20;
    min-width: 232px;
    padding: 6px;
    background: var(--win);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-popover);
  }

  .nbtn[aria-expanded='true'] + .npanel {
    display: block;
  }

  .npanel a {
    position: relative;
    display: block;
    padding: 9px 12px 9px 14px;
    color: var(--body);
  }

  .npanel a:focus-visible {
    outline-offset: -2px;
  }

  .npanel a[aria-current='true'] {
    color: var(--ink);
    font-weight: 500;
  }

  .npanel a[aria-current='true']::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 11px;
    bottom: 11px;
    width: 2px;
    border-radius: var(--radius-marker);
    background: var(--accent);
  }

  .ndiv {
    display: none;
    height: 1px;
    margin: 6px 8px;
    background: var(--line);
  }

  .npanel .pext {
    display: none;
  }

  @media (max-width: 1040px) {
    .links > .sl {
      display: none;
    }

    .nmw {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .links {
      gap: 14px;
    }

    .links > .ext,
    .links > .sep {
      display: none;
    }

    .nbtn .lw {
      display: none;
    }

    .nbtn .lp {
      display: inline;
    }

    .ndiv,
    .npanel .pext {
      display: block;
    }

    .nmw {
      position: static;
    }

    .npanel {
      left: var(--gutter);
      right: var(--gutter);
      top: calc(100% - 4px);
      min-width: 0;
    }
  }
</style>

<script>
  const root = document.documentElement
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')

  function label() {
    if (!toggle) return
    const dark = root.getAttribute('data-theme') === 'dark'
    toggle.setAttribute(
      'aria-label',
      (dark ? toggle.dataset.toLight : toggle.dataset.toDark) ?? '',
    )
  }

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
    root.setAttribute('data-theme', next)
    try {
      localStorage.setItem('canon-theme', next)
    } catch {
      // A browser refusing storage still gets the theme for this page view.
    }
    label()
  })
  label()

  /* The Sections menu: Escape and a click outside close it, and focus returns to its button. */
  const button = document.querySelector<HTMLButtonElement>('.nbtn')
  const panel = document.getElementById('nav-panel')
  if (button && panel) {
    const isOpen = () => button.getAttribute('aria-expanded') === 'true'
    const set = (open: boolean) =>
      button.setAttribute('aria-expanded', String(open))
    button.addEventListener('click', () => set(!isOpen()))
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        set(false)
        button.focus()
      }
    })
    document.addEventListener('click', (event) => {
      const target = event.target
      if (
        isOpen() &&
        target instanceof Node &&
        !button.contains(target) &&
        !panel.contains(target)
      )
        set(false)
    })
    panel
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', () => set(false)))
  }

  /* The section in view marks its link in the bar and in the menu. */
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>('[data-section]'),
  ]
  const targets = [
    ...new Set(links.map((link) => link.dataset.section ?? '')),
  ].flatMap((id) => {
    const node = document.getElementById(id)
    return node ? [node] : []
  })
  const visible = new Set<string>()
  const mark = () => {
    const current = targets.find((node) => visible.has(node.id))?.id
    links.forEach((link) => {
      if (link.dataset.section === current)
        link.setAttribute('aria-current', 'true')
      else link.removeAttribute('aria-current')
    })
  }
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) visible.add(entry.target.id)
        else visible.delete(entry.target.id)
      })
      mark()
    },
    { rootMargin: '-40% 0px -55% 0px' },
  )
  targets.forEach((node) => observer.observe(node))
</script>
