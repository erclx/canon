---
import mark from '../../../../assets/brand/mark.svg?raw'
import { footer, nav, sections, site } from '../../content/copy'
import './style.css'

/**
 * The mark and tagline beside three link columns on the page's grid ground,
 * parted from the page by one soft rule, over a base row set apart by spacing
 * alone. The first column repeats the nav's section links in two columns, so
 * they carry no `.sl` class and the nav's in-view marker never reads them.
 */
const glyph = mark.replace(/<!--[\s\S]*?-->/, '').trim()
const columns = [
  {
    kind: 'page',
    head: footer.heads.page,
    links: sections.map((section) => ({
      label: section.label,
      href: `#${section.id}`,
    })),
  },
  { kind: 'read', head: footer.heads.read, links: footer.read },
  { kind: 'project', head: footer.heads.project, links: footer.project },
]
---

<footer class="site-footer">
  <div class="in">
    <div class="lead">
      <a class="brand" href="#top" aria-label={nav.back}>
        <span class="glyph" aria-hidden="true" set:html={glyph} />
        {nav.mark}
      </a>
      <p>{site.tagline}</p>
    </div>
    {
      columns.map((column) => (
        <div class:list={['col', column.kind]}>
          <h2>{column.head}</h2>
          <ul role="list">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="base">
      {footer.base.map((part) => <span>{part}</span>)}
    </div>
  </div>
</footer>
