---
import { pause } from '../../content/copy'
import PauseIcon from './pause.svg'
import PlayIcon from './play.svg'

/**
 * The one control that stops a looping window, set on the window's tray so it
 * never sits inside a window hidden from assistive technology. `holdOn` in
 * `lib/scene.ts` reads the press and swaps the label, and the stylesheet hides
 * the button under reduced motion, where no window loops.
 */
---

<button
  type="button"
  class="pz"
  aria-label={pause.pause}
  data-pause={pause.pause}
  data-play={pause.play}
  data-paused="false"
>
  <PauseIcon class="pz-off" aria-hidden="true" />
  <PlayIcon class="pz-on" aria-hidden="true" />
</button>
