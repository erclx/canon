{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "7628d228ebcf55072e019dc829423d3df724558c",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@erclx/canon",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "web",
        "canon",
        "internal",
        ".claude",
        ".github",
        ".husky",
        "sandbox",
        "examples",
        "wiki",
        "assets/evidence",
        "assets/frames",
        "assets/film",
        "assets/loops"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "claude/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "plugins/canon-media/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
