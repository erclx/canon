{
  "description": "Points a session started in an empty folder at canon:target-scaffold",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/empty-folder.sh"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
