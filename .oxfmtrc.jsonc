{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {},
  "ignorePatterns": [
    ".claude/GOV.md",

    // release-please rewrites these on every release and serializes them its own way
    "**/.claude-plugin/*.json",
    "/CHANGELOG.md",

    // hand-authored, no tool writes it, so it keeps its format gate
    "!.claude-plugin/marketplace.json",

    // regen-hero.ts writes these and serializes them its own way. Formatting them
    // too gives each file two writers that disagree, and the Hero stage then
    // fails for whichever of them committed last rather than for a stale count.
    // The templates beside them are hand-edited and keep their format gate, which
    // the glob leaves alone because a template ends in .tmpl rather than .html.
    //
    // The glob covers the folder rather than naming each frame, since the script
    // loops over whatever templates the folder holds and a frame added later would
    // otherwise arrive with two writers and no sign of it until their output first
    // disagreed.
    "/assets/captures/*.html",

    // regen-web-previews.ts writes these and serializes them its own way, the raw
    // render. bun run format runs oxfmt over the same files and would rewrite
    // them, so web:build and format each leave a file the other disagrees with.
    // The folder has one writer, the script, and nothing edits a preview by hand.
    // web/public/evidence/ and the hand-authored web sources keep their format gate.
    "/web/public/previews/",

    // design-sync.ts writes these as the board frame holds them, and its --check
    // compares the bytes. Formatting them too gives each file two writers, and
    // the check then fails for whichever committed last.
    "/canon/design/**/*.html",

    // The launch film's HyperFrames source, copied byte for byte from the project
    // that rendered the README loops. Reflowing its markup can move whitespace the
    // compositions lay out, so the tracked source stays the rendered source.
    "/assets/film/",

    // Prettier formats these with prettier-plugin-astro, since oxfmt loads no
    // Prettier plugin. One formatter per file keeps the two from fighting.
    "**/*.astro",
  ],
}
