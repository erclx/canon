{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {},
  "ignorePatterns": [
    ".claude/GOV.md",

    // release-please rewrites these on every release and serializes them its own way
    "**/.claude-plugin/*.json",
    "/CHANGELOG.md",

    // hand-authored, no tool writes it, so it keeps its format gate
    "!.claude-plugin/marketplace.json",

    // regen-web-previews.ts writes these and serializes them its own way, the raw
    // render. bun run format runs oxfmt over the same files and would rewrite
    // them, so web:build and format each leave a file the other disagrees with.
    // The folder has one writer, the script, and nothing edits a preview by hand.
    // web/public/evidence/ and the hand-authored web sources keep their format gate.
    "/web/public/previews/",

    // design-sync.ts writes these as the board holds them, the frame HTML and the
    // assets it copies under kit/, and its --check compares the bytes. Formatting
    // them too gives each file two writers, and the check then fails for whichever
    // committed last.
    "/canon/design/**/*.html",
    "/canon/design/kit/",

    // The launch film's HyperFrames source, copied byte for byte from the project
    // that rendered the README loops. Reflowing its markup can move whitespace the
    // compositions lay out, so the tracked source stays the rendered source.
    "/assets/film/",

    // Prettier formats these with prettier-plugin-astro, since oxfmt loads no
    // Prettier plugin. One formatter per file keeps the two from fighting.
    "**/*.astro",
  ],
}
